@{
    ViewData["Title"] = "مدیریت پروکسی‌ها";
}

<div class="row">
    <!-- Proxy Statistics -->
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-globe me-2"></i>
                    آمار پروکسی‌ها
                </h5>
                <div>
                    <button class="btn btn-outline-primary btn-sm" onclick="refreshStats()">
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        بروزرسانی
                    </button>
                    <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>
                        پروکسی جدید
                    </a>
                </div>
            </div>
            <div class="card-body">
                <div class="row" id="proxyStatsCards">
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-primary mb-1" id="totalProxies">0</h4>
                            <small class="text-muted">کل پروکسی‌ها</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-success mb-1" id="workingProxies">0</h4>
                            <small class="text-muted">در حال کار</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-danger mb-1" id="failedProxies">0</h4>
                            <small class="text-muted">خراب</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h4 class="text-info mb-1" id="avgResponseTime">0ms</h4>
                            <small class="text-muted">زمان پاسخ میانگین</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Proxy Management -->
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <h6 class="mb-0">
                            <i class="bi bi-list me-2"></i>
                            لیست پروکسی‌ها
                        </h6>
                    </div>
                    <div class="col-md-6 text-end">
                        <div class="btn-group me-2">
                            <button class="btn btn-outline-success btn-sm" onclick="testAllProxies()">
                                <i class="bi bi-check-circle me-1"></i>
                                تست همه
                            </button>
                            <button class="btn btn-outline-warning btn-sm" onclick="bulkActions()">
                                <i class="bi bi-gear me-1"></i>
                                عملیات گروهی
                            </button>
                        </div>
                        <div class="btn-group">
                            <button class="btn btn-outline-info btn-sm" onclick="importProxies()">
                                <i class="bi bi-upload me-1"></i>
                                وارد کردن
                            </button>
                            <a href="@Url.Action("Pools")" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-collection me-1"></i>
                                مجموعه‌ها
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <!-- Filters -->
                <div class="p-3 border-bottom bg-light">
                    <div class="row">
                        <div class="col-md-3">
                            <select class="form-select form-select-sm" id="statusFilter">
                                <option value="">همه وضعیت‌ها</option>
                                <option value="Working">در حال کار</option>
                                <option value="Failed">خراب</option>
                                <option value="Slow">کند</option>
                                <option value="Timeout">تایم‌اوت</option>
                                <option value="Unknown">نامشخص</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control form-control-sm" id="countryFilter" 
                                   placeholder="فیلتر کشور...">
                        </div>
                        <div class="col-md-3">
                            <input type="text" class="form-control form-control-sm" id="searchInput" 
                                   placeholder="جستجو در آدرس...">
                        </div>
                        <div class="col-md-3">
                            <div class="btn-group w-100">
                                <button class="btn btn-primary btn-sm" onclick="applyFilters()">
                                    <i class="bi bi-funnel"></i>
                                    فیلتر
                                </button>
                                <button class="btn btn-outline-secondary btn-sm" onclick="clearFilters()">
                                    <i class="bi bi-x"></i>
                                    پاک
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Proxy Table -->
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="proxiesTable">
                        <thead class="table-light">
                            <tr>
                                <th width="5%">
                                    <input type="checkbox" id="selectAll" onchange="toggleSelectAll()">
                                </th>
                                <th width="15%">آدرس</th>
                                <th width="10%">نوع</th>
                                <th width="10%">وضعیت</th>
                                <th width="10%">کشور</th>
                                <th width="10%">اولویت</th>
                                <th width="10%">نرخ موفقیت</th>
                                <th width="10%">زمان پاسخ</th>
                                <th width="15%">آخرین بررسی</th>
                                <th width="5%">عملیات</th>
                            </tr>
                        </thead>
                        <tbody id="proxiesTableBody">
                            <!-- Proxies will be loaded here -->
                        </tbody>
                    </table>
                </div>

                <!-- Loading State -->
                <div id="loadingState" class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-2 text-muted">در حال بارگذاری پروکسی‌ها...</p>
                </div>

                <!-- Empty State -->
                <div id="emptyState" class="text-center p-4" style="display: none;">
                    <i class="bi bi-globe-asia-australia display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">هیچ پروکسی‌ای یافت نشد</h5>
                    <p class="text-muted">پروکسی‌های جدید اضافه کنید یا فیلترها را تغییر دهید</p>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        اولین پروکسی را اضافه کنید
                    </a>
                </div>
            </div>

            <!-- Pagination -->
            <div class="card-footer">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <span class="text-muted" id="proxyCount">0 پروکسی</span>
                    </div>
                    <div class="col-md-6">
                        <nav aria-label="Proxy pagination">
                            <ul class="pagination pagination-sm justify-content-end mb-0" id="pagination">
                                <!-- Pagination will be generated here -->
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bulk Actions Modal -->
<div class="modal fade" id="bulkActionsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">عملیات گروهی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">انتخاب شده: <span id="selectedCount">0</span> پروکسی</label>
                </div>
                
                <div class="mb-3">
                    <h6>تغییر وضعیت</h6>
                    <select class="form-select" id="bulkStatus">
                        <option value="">انتخاب کنید...</option>
                        <option value="Working">در حال کار</option>
                        <option value="Failed">خراب</option>
                        <option value="Slow">کند</option>
                    </select>
                    <button class="btn btn-warning btn-sm mt-2" onclick="updateBulkStatus()">
                        بروزرسانی وضعیت
                    </button>
                </div>

                <div class="mb-3">
                    <h6>تست گروهی</h6>
                    <button class="btn btn-info btn-sm" onclick="testSelectedProxies()">
                        <i class="bi bi-check-circle me-1"></i>
                        تست انتخاب شده‌ها
                    </button>
                </div>

                <div class="mb-3">
                    <h6>حذف گروهی</h6>
                    <button class="btn btn-danger btn-sm" onclick="deleteSelectedProxies()">
                        <i class="bi bi-trash me-1"></i>
                        حذف انتخاب شده‌ها
                    </button>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

<!-- Import Proxies Modal -->
<div class="modal fade" id="importModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">وارد کردن پروکسی‌ها</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">فرمت:</label>
                    <code>host:port</code> یا <code>host:port:username:password</code>
                </div>
                <div class="mb-3">
                    <textarea class="form-control" id="importData" rows="10" 
                              placeholder="192.168.1.1:8080&#10;192.168.1.2:3128:user:pass&#10;..."></textarea>
                </div>
                <div class="mb-3">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label">نوع پروکسی</label>
                            <select class="form-select" id="importType">
                                <option value="Http">HTTP</option>
                                <option value="Https">HTTPS</option>
                                <option value="Socks4">SOCKS4</option>
                                <option value="Socks5">SOCKS5</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">اولویت</label>
                            <input type="number" class="form-control" id="importPriority" value="5" min="1" max="10">
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="processImport()">
                    <i class="bi bi-upload me-1"></i>
                    وارد کردن
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let selectedProxies = new Set();

        document.addEventListener('DOMContentLoaded', function() {
            loadProxies();
            loadProxyStats();
            setupEventListeners();
        });

        function setupEventListeners() {
            document.getElementById('searchInput').addEventListener('input', debounce(applyFilters, 500));
            document.getElementById('statusFilter').addEventListener('change', applyFilters);
            document.getElementById('countryFilter').addEventListener('input', debounce(applyFilters, 500));
        }

        async function loadProxies(page = 1) {
            try {
                showLoading();
                
                const params = new URLSearchParams({
                    skip: ((page - 1) * 50).toString(),
                    take: '50',
                    status: document.getElementById('statusFilter').value
                });

                const response = await fetch(`/Proxy/GetProxiesJson?${params}`);
                const proxies = await response.json();

                if (proxies.error) {
                    showError(proxies.error);
                    return;
                }

                displayProxies(proxies);
                updatePagination(proxies.length, page);
                hideLoading();
            } catch (error) {
                console.error('Error loading proxies:', error);
                showError('خطا در بارگذاری پروکسی‌ها');
                hideLoading();
            }
        }

        function displayProxies(proxies) {
            const tbody = document.getElementById('proxiesTableBody');
            
            if (proxies.length === 0) {
                document.getElementById('emptyState').style.display = 'block';
                tbody.innerHTML = '';
                document.getElementById('proxyCount').textContent = '0 پروکسی';
                return;
            }

            document.getElementById('emptyState').style.display = 'none';
            
            tbody.innerHTML = proxies.map(proxy => {
                const statusBadge = getStatusBadge(proxy.status);
                const typeBadge = getTypeBadge(proxy.type);
                
                return `
                    <tr data-proxy-id="${proxy.id}">
                        <td>
                            <input type="checkbox" class="proxy-select" value="${proxy.id}" 
                                   onchange="toggleProxySelection('${proxy.id}')">
                        </td>
                        <td>
                            <a href="/Proxy/Details/${proxy.id}" class="text-decoration-none">
                                <strong>${proxy.displayName}</strong>
                            </a>
                            ${proxy.country ? `<br><small class="text-muted">${proxy.country}</small>` : ''}
                        </td>
                        <td>${typeBadge}</td>
                        <td>${statusBadge}</td>
                        <td>${proxy.country || '-'}</td>
                        <td>
                            <span class="badge ${proxy.priority <= 3 ? 'bg-success' : proxy.priority <= 7 ? 'bg-warning' : 'bg-secondary'}">
                                ${proxy.priority}
                            </span>
                        </td>
                        <td>
                            <span class="badge ${proxy.successRate >= 80 ? 'bg-success' : proxy.successRate >= 50 ? 'bg-warning' : 'bg-danger'}">
                                ${proxy.successRate.toFixed(1)}%
                            </span>
                        </td>
                        <td>
                            ${proxy.responseTime > 0 ? `${Math.round(proxy.responseTime)}ms` : '-'}
                        </td>
                        <td>
                            <small class="text-muted">${formatDateTime(proxy.lastChecked)}</small>
                        </td>
                        <td>
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-info" onclick="testProxy('${proxy.id}')" title="تست">
                                    <i class="bi bi-check-circle"></i>
                                </button>
                                <a href="/Proxy/Edit/${proxy.id}" class="btn btn-sm btn-outline-primary" title="ویرایش">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            document.getElementById('proxyCount').textContent = `${proxies.length} پروکسی`;
        }

        function getStatusBadge(status) {
            const badges = {
                'Working': '<span class="badge bg-success">در حال کار</span>',
                'Failed': '<span class="badge bg-danger">خراب</span>',
                'Slow': '<span class="badge bg-warning">کند</span>',
                'Timeout': '<span class="badge bg-secondary">تایم‌اوت</span>',
                'Unknown': '<span class="badge bg-light text-dark">نامشخص</span>'
            };
            return badges[status] || '<span class="badge bg-secondary">نامشخص</span>';
        }

        function getTypeBadge(type) {
            const badges = {
                'Http': '<span class="badge bg-primary">HTTP</span>',
                'Https': '<span class="badge bg-success">HTTPS</span>',
                'Socks4': '<span class="badge bg-info">SOCKS4</span>',
                'Socks5': '<span class="badge bg-warning">SOCKS5</span>'
            };
            return badges[type] || '<span class="badge bg-secondary">نامشخص</span>';
        }

        async function loadProxyStats() {
            try {
                const response = await fetch('/Proxy/GetProxyStats');
                const stats = await response.json();
                
                if (stats.error) {
                    console.error('Error loading proxy stats:', stats.error);
                    return;
                }

                document.getElementById('totalProxies').textContent = stats.totalProxies;
                document.getElementById('workingProxies').textContent = stats.workingProxies;
                document.getElementById('failedProxies').textContent = stats.failedProxies;
                document.getElementById('avgResponseTime').textContent = Math.round(stats.averageResponseTime) + 'ms';
                
            } catch (error) {
                console.error('Error loading proxy stats:', error);
            }
        }

        async function testProxy(proxyId) {
            try {
                const response = await fetch(`/Proxy/TestProxy?id=${proxyId}`, { method: 'POST' });
                const result = await response.json();
                
                if (result.success && result.result.isSuccessful) {
                    IvaScanner.showNotification('تست موفق', 'پروکسی به درستی کار می‌کند', 'success');
                } else {
                    const errorMsg = result.result?.errorMessage || 'تست ناموفق';
                    IvaScanner.showNotification('تست ناموفق', errorMsg, 'error');
                }
                
                // Reload current page to show updated status
                loadProxies(currentPage);
                
            } catch (error) {
                console.error('Error testing proxy:', error);
                IvaScanner.showNotification('خطا در تست', 'خطا در تست پروکسی', 'error');
            }
        }

        function toggleSelectAll() {
            const selectAll = document.getElementById('selectAll');
            const checkboxes = document.querySelectorAll('.proxy-select');
            
            checkboxes.forEach(checkbox => {
                checkbox.checked = selectAll.checked;
                if (selectAll.checked) {
                    selectedProxies.add(checkbox.value);
                } else {
                    selectedProxies.delete(checkbox.value);
                }
            });
            
            updateSelectedCount();
        }

        function toggleProxySelection(proxyId) {
            const checkbox = document.querySelector(`.proxy-select[value="${proxyId}"]`);
            if (checkbox.checked) {
                selectedProxies.add(proxyId);
            } else {
                selectedProxies.delete(proxyId);
            }
            
            updateSelectedCount();
        }

        function updateSelectedCount() {
            document.getElementById('selectedCount').textContent = selectedProxies.size;
        }

        function bulkActions() {
            updateSelectedCount();
            new bootstrap.Modal(document.getElementById('bulkActionsModal')).show();
        }

        async function updateBulkStatus() {
            const status = document.getElementById('bulkStatus').value;
            if (!status || selectedProxies.size === 0) {
                IvaScanner.showNotification('خطا', 'وضعیت و پروکسی‌ها را انتخاب کنید', 'warning');
                return;
            }

            try {
                const response = await fetch('/Proxy/BulkUpdateStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        proxyIds: Array.from(selectedProxies),
                        status: status
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    IvaScanner.showNotification('موفق', result.message, 'success');
                    loadProxies(currentPage);
                    loadProxyStats();
                    bootstrap.Modal.getInstance(document.getElementById('bulkActionsModal')).hide();
                } else {
                    IvaScanner.showNotification('خطا', result.error, 'error');
                }
            } catch (error) {
                console.error('Error updating bulk status:', error);
                IvaScanner.showNotification('خطا', 'خطا در بروزرسانی گروهی', 'error');
            }
        }

        async function testSelectedProxies() {
            if (selectedProxies.size === 0) {
                IvaScanner.showNotification('خطا', 'پروکسی‌هایی را انتخاب کنید', 'warning');
                return;
            }

            try {
                const response = await fetch('/Proxy/BulkTestProxies', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(Array.from(selectedProxies))
                });

                const result = await response.json();
                
                if (result.success) {
                    IvaScanner.showNotification('تست کامل', 
                        `${result.working} از ${result.tested} پروکسی کار می‌کند`, 'info');
                    loadProxies(currentPage);
                    loadProxyStats();
                } else {
                    IvaScanner.showNotification('خطا', result.error, 'error');
                }
            } catch (error) {
                console.error('Error bulk testing proxies:', error);
                IvaScanner.showNotification('خطا', 'خطا در تست گروهی', 'error');
            }
        }

        function importProxies() {
            new bootstrap.Modal(document.getElementById('importModal')).show();
        }

        async function processImport() {
            const data = document.getElementById('importData').value.trim();
            const type = document.getElementById('importType').value;
            const priority = parseInt(document.getElementById('importPriority').value);

            if (!data) {
                IvaScanner.showNotification('خطا', 'لطفاً داده‌های پروکسی را وارد کنید', 'warning');
                return;
            }

            const lines = data.split('\n').filter(line => line.trim());
            const proxies = [];

            for (const line of lines) {
                const parts = line.trim().split(':');
                if (parts.length >= 2) {
                    const proxy = {
                        host: parts[0],
                        port: parseInt(parts[1]),
                        type: type,
                        priority: priority
                    };

                    if (parts.length >= 4) {
                        proxy.username = parts[2];
                        proxy.password = parts[3];
                    }

                    proxies.push(proxy);
                }
            }

            if (proxies.length === 0) {
                IvaScanner.showNotification('خطا', 'هیچ پروکسی معتبری یافت نشد', 'error');
                return;
            }

            try {
                const response = await fetch('/Proxy/ImportProxies', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(proxies)
                });

                const result = await response.json();
                
                if (result.success) {
                    IvaScanner.showNotification('موفق', result.message, 'success');
                    loadProxies(currentPage);
                    loadProxyStats();
                    bootstrap.Modal.getInstance(document.getElementById('importModal')).hide();
                    document.getElementById('importData').value = '';
                } else {
                    IvaScanner.showNotification('خطا', result.error, 'error');
                }
            } catch (error) {
                console.error('Error importing proxies:', error);
                IvaScanner.showNotification('خطا', 'خطا در وارد کردن پروکسی‌ها', 'error');
            }
        }

        function applyFilters() {
            currentPage = 1;
            loadProxies(currentPage);
        }

        function clearFilters() {
            document.getElementById('statusFilter').value = '';
            document.getElementById('countryFilter').value = '';
            document.getElementById('searchInput').value = '';
            applyFilters();
        }

        function refreshStats() {
            loadProxyStats();
            loadProxies(currentPage);
        }

        function showLoading() {
            document.getElementById('loadingState').style.display = 'block';
            document.getElementById('emptyState').style.display = 'none';
        }

        function hideLoading() {
            document.getElementById('loadingState').style.display = 'none';
        }

        function showError(message) {
            document.getElementById('loadingState').innerHTML = `
                <div class="text-center p-4">
                    <i class="bi bi-exclamation-triangle display-1 text-danger"></i>
                    <h5 class="mt-3 text-danger">خطا در بارگذاری</h5>
                    <p class="text-muted">${message}</p>
                    <button class="btn btn-outline-primary" onclick="loadProxies()">تلاش مجدد</button>
                </div>
            `;
        }

        function updatePagination(itemCount, currentPageNum) {
            // Simple pagination implementation
            // For full implementation, you'd need total count from server
        }

        function formatDateTime(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('fa-IR') + ' ' + date.toLocaleTimeString('fa-IR');
        }

        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }
    </script>
}
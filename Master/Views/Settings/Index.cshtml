@{
    ViewData["Title"] = "تنظیمات سیستم";
    var settings = ViewBag.Settings;
}

<div class="row g-3">
    <!-- Worker Settings -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-people me-2"></i>
                تنظیمات ورکر
            </div>
            <div class="card-body">
                <form asp-action="UpdateWorkerSettings" method="post">
                    <div class="mb-3">
                        <label class="form-label">فاصله Heartbeat (ثانیه)</label>
                        <input type="number" name="heartbeatIntervalSeconds" class="form-control"
                               value="@(settings?.WorkerSettings?.HeartbeatIntervalSeconds ?? 30)" min="5" max="300">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تایم‌اوت Heartbeat (ثانیه)</label>
                        <input type="number" name="heartbeatTimeoutSeconds" class="form-control"
                               value="@(settings?.WorkerSettings?.HeartbeatTimeoutSeconds ?? 60)" min="10" max="600">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تایم‌اوت Task Lease (دقیقه)</label>
                        <input type="number" name="taskLeaseTimeoutMinutes" class="form-control"
                               value="@(settings?.WorkerSettings?.TaskLeaseTimeoutMinutes ?? 2)" min="1" max="30">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">حداکثر تلاش مجدد</label>
                        <input type="number" name="maxRetryAttempts" class="form-control"
                               value="@(settings?.WorkerSettings?.MaxRetryAttempts ?? 3)" min="0" max="10">
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        ذخیره تنظیمات ورکر
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Scan Settings -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-search me-2"></i>
                تنظیمات اسکن
            </div>
            <div class="card-body">
                <form asp-action="UpdateScanSettings" method="post">
                    <div class="mb-3">
                        <label class="form-label">اندازه Chunk برای CVV</label>
                        <input type="number" name="cvvChunkSize" class="form-control"
                               value="@(settings?.ScanSettings?.CvvChunkSize ?? 100)" min="10" max="1000">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">حداکثر اسکن همزمان</label>
                        <input type="number" name="maxConcurrentJobs" class="form-control"
                               value="@(settings?.ScanSettings?.MaxConcurrentJobs ?? 10)" min="1" max="100">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تاخیر بین درخواست‌ها (میلی‌ثانیه)</label>
                        <input type="number" name="requestDelayMs" class="form-control"
                               value="@(settings?.ScanSettings?.RequestDelayMs ?? 1000)" min="100" max="10000">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تایم‌اوت درخواست (ثانیه)</label>
                        <input type="number" name="timeoutSeconds" class="form-control"
                               value="@(settings?.ScanSettings?.TimeoutSeconds ?? 30)" min="5" max="300">
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        ذخیره تنظیمات اسکن
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Database / Redis -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-database me-2"></i>
                پایگاه داده و Redis
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Connection String (پایگاه داده)</label>
                    <input type="text" class="form-control" readonly
                           value="@(settings?.DatabaseSettings?.ConnectionString ?? "-")">
                </div>
                <div class="mb-3">
                    <label class="form-label">Connection String (Redis)</label>
                    <input type="text" class="form-control" readonly
                           value="@(settings?.DatabaseSettings?.RedisConnectionString ?? "-")">
                </div>
                <div class="d-flex gap-2">
                    <form asp-action="TestDatabaseConnection" method="post">
                        <button type="submit" class="btn btn-outline-primary">
                            <i class="bi bi-hdd-stack me-1"></i>
                            تست پایگاه داده
                        </button>
                    </form>
                    <form asp-action="TestRedisConnection" method="post">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-lightning-charge me-1"></i>
                            تست Redis
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- System Settings -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-gear me-2"></i>
                تنظیمات سیستم
            </div>
            <div class="card-body">
                <form asp-action="UpdateSystemSettings" method="post">
                    <div class="mb-3">
                        <label class="form-label">مدت نگه‌داری لاگ (روز)</label>
                        <input type="number" name="logRetentionDays" class="form-control"
                               value="@(settings?.SystemSettings?.LogRetentionDays ?? 30)" min="1" max="365">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">حداکثر حجم فایل لاگ</label>
                        <input type="text" name="maxLogFileSize" class="form-control"
                               value="@(settings?.SystemSettings?.MaxLogFileSize ?? "100MB")">
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="enableDetailedLogging"
                               value="true" id="enableDetailedLogging"
                               checked="@(settings?.SystemSettings?.EnableDetailedLogging == true)">
                        <label class="form-check-label" for="enableDetailedLogging">
                            فعال‌سازی لاگ تفصیلی
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>
                        ذخیره تنظیمات سیستم
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-info-circle me-2"></i>
                اطلاعات سیستم
            </div>
            <div class="card-body">
                <div class="row g-3" id="systemInfo">
                    <div class="col-md-3 text-center">
                        <div class="stat-value" id="sysVersion">-</div>
                        <div class="stat-label">نسخه</div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="stat-value" id="sysUptime">-</div>
                        <div class="stat-label">آپتایم</div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="stat-value" id="sysMemory">-</div>
                        <div class="stat-label">حافظه مصرفی</div>
                    </div>
                    <div class="col-md-3 text-center">
                        <div class="stat-value" id="sysCpu">-</div>
                        <div class="stat-label">تعداد پردازنده</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        fetch('/Settings/GetSystemInfo')
            .then(r => r.json())
            .then(info => {
                if (info.error) return;
                document.getElementById('sysVersion').textContent = info.version;
                document.getElementById('sysCpu').textContent = info.processorCount;
                document.getElementById('sysMemory').textContent = Math.round(info.memoryUsage / 1024 / 1024) + ' MB';

                const uptimeSeconds = info.uptime ? info.uptime.totalSeconds || 0 : 0;
                const hours = Math.floor(uptimeSeconds / 3600);
                const minutes = Math.floor((uptimeSeconds % 3600) / 60);
                document.getElementById('sysUptime').textContent = `${hours}h ${minutes}m`;
            })
            .catch(err => console.error('Error loading system info:', err));
    </script>
}

@model IvaScanner.Core.Models.CreateRemoteServerRequest
@{
    ViewData["Title"] = "افزودن سرور جدید";
    Layout = "_Layout";
}

<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-hdd-network me-2"></i>
                افزودن سرور Remote جدید
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" id="createServerForm">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label">نام سرور <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="مثل: Production-Server-01" required>
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="IpAddress" class="form-label">آدرس IP <span class="text-danger">*</span></label>
                            <input asp-for="IpAddress" class="form-control" placeholder="192.168.1.100" required>
                            <span asp-validation-for="IpAddress" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SshPort" class="form-label">پورت SSH</label>
                            <input asp-for="SshPort" type="number" class="form-control" value="22" min="1" max="65535">
                            <span asp-validation-for="SshPort" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="OperatingSystem" class="form-label">سیستم‌عامل</label>
                            <select asp-for="OperatingSystem" class="form-select" id="OperatingSystem">
                                <option value="Linux">Linux</option>
                                <option value="Windows">Windows</option>
                                <option value="MacOS">macOS</option>
                            </select>
                            <span asp-validation-for="OperatingSystem" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Username" class="form-label">نام کاربری <span class="text-danger">*</span></label>
                            <input asp-for="Username" class="form-control" placeholder="root یا administrator" required>
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">روش احراز هویت</label>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="authMethod" id="authPassword" value="password" checked>
                                <label class="form-check-label" for="authPassword">رمز عبور</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="authMethod" id="authKey" value="key">
                                <label class="form-check-label" for="authKey">کلید خصوصی (Private Key)</label>
                            </div>
                        </div>
                    </div>

                    <div class="row" id="passwordSection">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label">رمز عبور</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="رمز عبور SSH">
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row" id="keySection" style="display: none;">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PrivateKeyPath" class="form-label">مسیر کلید خصوصی</label>
                            <input asp-for="PrivateKeyPath" class="form-control" placeholder="/path/to/private/key">
                            <span asp-validation-for="PrivateKeyPath" class="text-danger"></span>
                        </div>
                    </div>

                    <hr>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="WorkerPath" class="form-label">مسیر نصب Worker</label>
                            <input asp-for="WorkerPath" class="form-control" id="WorkerPath" placeholder="/opt/iva-worker">
                            <small class="form-text text-muted">خالی بگذارید برای استفاده از مسیر پیش‌فرض</small>
                            <span asp-validation-for="WorkerPath" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="MaxWorkers" class="form-label">حداکثر تعداد Worker</label>
                            <input asp-for="MaxWorkers" type="number" class="form-control" value="2" min="1" max="20">
                            <span asp-validation-for="MaxWorkers" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="AutoDeploy" class="form-check-input" type="checkbox">
                        <label asp-for="AutoDeploy" class="form-check-label">
                            Deploy خودکار Workerها پس از افزودن سرور
                        </label>
                        <small class="form-text text-muted d-block">
                            در صورت فعال‌سازی، بلافاصله پس از تست موفق اتصال، Workerها نصب خواهند شد
                        </small>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <button type="button" class="btn btn-outline-info" id="testConnection">
                            <i class="bi bi-plug me-1"></i>
                            تست اتصال
                        </button>
                        <small class="form-text text-muted ms-2">
                            پیش از ذخیره، اتصال به سرور را تست کنید
                        </small>
                    </div>

                    <div id="connectionResult" class="alert" style="display: none;"></div>

                    <div class="text-center">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-save me-1"></i>
                            ذخیره سرور
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-lg ms-2">
                            <i class="bi bi-x-lg me-1"></i>
                            انصراف
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Server Requirements Card -->
        <div class="card mt-4">
            <div class="card-header">
                <i class="bi bi-info-circle me-2"></i>
                پیش‌نیازهای سرور
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-primary">Linux Servers:</h6>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-check-lg text-success me-1"></i> Ubuntu 20.04+ / CentOS 8+ / Debian 11+</li>
                            <li><i class="bi bi-check-lg text-success me-1"></i> SSH Server فعال</li>
                            <li><i class="bi bi-check-lg text-success me-1"></i> دسترسی sudo</li>
                            <li><i class="bi bi-check-lg text-success me-1"></i> حداقل 2GB RAM</li>
                            <li><i class="bi bi-check-lg text-success me-1"></i> .NET 8.0 Runtime (نصب خودکار)</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-primary">Windows Servers:</h6>
                        <ul class="list-unstyled">
                            <li><i class="bi bi-check-lg text-success me-1"></i> Windows Server 2019+</li>
                            <li><i class="bi bi-check-lg text-success me-1"></i> OpenSSH Server یا PowerShell Remoting</li>
                            <li><i class="bi bi-check-lg text-success me-1"></i> دسترسی Administrator</li>
                            <li><i class="bi bi-check-lg text-success me-1"></i> حداقل 2GB RAM</li>
                            <li><i class="bi bi-check-lg text-success me-1"></i> .NET 8.0 Runtime (نصب خودکار)</li>
                        </ul>
                    </div>
                </div>

                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    <strong>نکات مهم:</strong>
                    <ul class="mb-0 mt-2">
                        <li>اطمینان حاصل کنید که سرور به اینترنت دسترسی دارد</li>
                        <li>فایروال سرور باید اتصال SSH/RDP را مجاز کند</li>
                        <li>برای امنیت بیشتر، استفاده از کلید خصوصی توصیه می‌شود</li>
                        <li>کاربر SSH باید دسترسی نصب نرم‌افزار داشته باشد</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const passwordSection = document.getElementById('passwordSection');
            const keySection = document.getElementById('keySection');
            const passwordInput = document.querySelector('input[name="Password"]');
            const keyInput = document.querySelector('input[name="PrivateKeyPath"]');

            // Auth method toggle
            document.querySelectorAll('input[name="authMethod"]').forEach(radio => {
                radio.addEventListener('change', function () {
                    if (this.value === 'password') {
                        passwordSection.style.display = '';
                        keySection.style.display = 'none';
                        passwordInput.required = true;
                        keyInput.required = false;
                    } else {
                        passwordSection.style.display = 'none';
                        keySection.style.display = '';
                        passwordInput.required = false;
                        keyInput.required = true;
                    }
                });
            });

            // Test connection
            document.getElementById('testConnection').addEventListener('click', function () {
                const button = this;
                const originalHtml = button.innerHTML;
                button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> در حال تست...';
                button.disabled = true;

                const resultBox = document.getElementById('connectionResult');
                resultBox.style.display = 'none';

                const formData = new URLSearchParams({
                    name: document.getElementById('Name').value,
                    ipAddress: document.getElementById('IpAddress').value,
                    sshPort: document.getElementById('SshPort').value,
                    username: document.getElementById('Username').value,
                    password: passwordInput.value,
                    privateKeyPath: keyInput.value,
                    operatingSystem: document.getElementById('OperatingSystem').value
                });

                fetch('@Url.Action("TestConnection", "RemoteServer")', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData.toString()
                })
                    .then(r => r.json())
                    .then(result => {
                        const alertClass = result.success ? 'alert-success' : 'alert-danger';
                        const icon = result.success ? 'bi-check-circle' : 'bi-x-circle';

                        let html = `<i class="bi ${icon} me-1"></i><strong>${result.success ? 'اتصال موفق!' : 'اتصال ناموفق!'}</strong><br>`;

                        if (result.success) {
                            html += `
                                <ul class="mb-0 mt-2">
                                    <li>.NET نصب شده: ${result.hasDotNet ? 'بله' : 'خیر'} ${result.dotNetVersion ? '(' + result.dotNetVersion + ')' : ''}</li>
                                    <li>Systemd دردسترس: ${result.hasSystemd ? 'بله' : 'خیر'}</li>
                                    <li>دسترسی Sudo: ${result.hasSudo ? 'بله' : 'خیر'}</li>
                                </ul>`;
                        } else {
                            html += `<p class="mb-0">${result.errorMessage || ''}</p>`;
                        }

                        resultBox.className = 'alert ' + alertClass;
                        resultBox.innerHTML = html;
                        resultBox.style.display = 'block';
                    })
                    .catch(() => {
                        resultBox.className = 'alert alert-danger';
                        resultBox.innerHTML = '<i class="bi bi-x-circle me-1"></i><strong>خطا در تست اتصال</strong>';
                        resultBox.style.display = 'block';
                    })
                    .finally(() => {
                        button.innerHTML = originalHtml;
                        button.disabled = false;
                    });
            });

            // Form validation
            document.getElementById('createServerForm').addEventListener('submit', function (e) {
                const authMethod = document.querySelector('input[name="authMethod"]:checked').value;

                if (authMethod === 'password' && !passwordInput.value) {
                    e.preventDefault();
                    alert('لطفاً رمز عبور را وارد کنید');
                    return false;
                }

                if (authMethod === 'key' && !keyInput.value) {
                    e.preventDefault();
                    alert('لطفاً مسیر کلید خصوصی را وارد کنید');
                    return false;
                }
            });

            // Auto-fill worker path based on OS
            document.getElementById('OperatingSystem').addEventListener('change', function () {
                const workerPath = document.getElementById('WorkerPath');
                if (!workerPath.value) {
                    switch (this.value) {
                        case 'Linux': workerPath.value = '/opt/iva-worker'; break;
                        case 'Windows': workerPath.value = 'C:\\IvaWorker'; break;
                        case 'MacOS': workerPath.value = '/usr/local/iva-worker'; break;
                    }
                }
            });
        });
    </script>
}

@model UpdateIvaAccountRequest
@{
    ViewData["Title"] = "ویرایش اکانت ایوا";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-pencil me-2"></i>
                    ویرایش اکانت ایوا
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input asp-for="Id" type="hidden">
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label">
                                <i class="bi bi-telephone me-1"></i>
                                شماره تلفن
                            </label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="09xxxxxxxxx" 
                                   pattern="[0-9]{11}" maxlength="11" required>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label class="form-label">
                                <i class="bi bi-toggle-on me-1"></i>
                                وضعیت
                            </label>
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch">
                                <label class="form-check-label" for="isActiveSwitch">
                                    فعال
                                </label>
                            </div>
                            <small class="form-text text-muted">اکانت فعال آماده استفاده توسط ورکرها است</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SessionData" class="form-label">
                            <i class="bi bi-key me-1"></i>
                            اطلاعات Session
                        </label>
                        <div class="input-group">
                            <textarea asp-for="SessionData" class="form-control" rows="4" 
                                      placeholder="اطلاعات session..."></textarea>
                            <button class="btn btn-outline-secondary" type="button" onclick="clearSession()">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                        <span asp-validation-for="SessionData" class="text-danger"></span>
                        <small class="form-text text-muted">
                            اطلاعات session برای حفظ وضعیت لاگین استفاده می‌شود
                        </small>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">اطلاعات اکانت</h6>
                                    <p class="card-text mb-1">
                                        <strong>شناسه:</strong> <code>@Model.Id</code>
                                    </p>
                                    <p class="card-text mb-0">
                                        <strong>تاریخ ایجاد:</strong> 
                                        <span id="createdAt">در حال بارگذاری...</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">وضعیت اختصاص</h6>
                                    <p class="card-text mb-1" id="assignmentStatus">
                                        در حال بارگذاری...
                                    </p>
                                    <div id="assignmentActions"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning">
                        <h6><i class="bi bi-exclamation-triangle me-2"></i>توجه:</h6>
                        <ul class="mb-0">
                            <li>تغییر شماره تلفن ممکن است نیاز به احراز هویت مجدد داشته باشد</li>
                            <li>پاک کردن Session Data موجب خروج از اکانت می‌شود</li>
                            <li>غیرفعال کردن اکانت آن را از دسترس ورکرها خارج می‌کند</li>
                        </ul>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="bi bi-arrow-right me-1"></i>
                            بازگشت
                        </a>
                        
                        <div>
                            <button type="button" class="btn btn-outline-danger me-2" onclick="testAccount()">
                                <i class="bi bi-wifi me-1"></i>
                                تست اتصال
                            </button>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check me-1"></i>
                                ذخیره تغییرات
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Session Test Modal -->
<div class="modal fade" id="testModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تست اتصال اکانت</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="testResults">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">در حال تست...</span>
                        </div>
                        <p class="mt-2">در حال بررسی اتصال...</p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load account details on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadAccountDetails();
        });

        // Phone number validation
        document.querySelector('input[name="PhoneNumber"]').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 11) {
                value = value.substring(0, 11);
            }
            e.target.value = value;
            
            const isValid = /^09[0-9]{9}$/.test(value);
            if (value.length === 11) {
                e.target.classList.toggle('is-valid', isValid);
                e.target.classList.toggle('is-invalid', !isValid);
            } else {
                e.target.classList.remove('is-valid', 'is-invalid');
            }
        });

        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const phoneInput = this.querySelector('input[name="PhoneNumber"]');
            const phoneNumber = phoneInput.value;
            
            if (!/^09[0-9]{9}$/.test(phoneNumber)) {
                e.preventDefault();
                IvaScanner.showNotification('شماره تلفن معتبر نیست', 'error');
                phoneInput.focus();
                return false;
            }
            
            const submitBtn = this.querySelector('button[type="submit"]');
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال ذخیره...';
            submitBtn.disabled = true;
        });

        // Load account details
        function loadAccountDetails() {
            const accountId = '@Model.Id';
            
            fetch(`/api/accounts/${accountId}`)
                .then(response => response.json())
                .then(account => {
                    if (!account.error) {
                        updateAccountInfo(account);
                    }
                })
                .catch(error => {
                    console.error('Error loading account details:', error);
                    document.getElementById('createdAt').textContent = 'خطا در بارگذاری';
                    document.getElementById('assignmentStatus').textContent = 'خطا در بارگذاری';
                });
        }

        function updateAccountInfo(account) {
            // Update created date
            const createdAt = new Date(account.createdAt);
            document.getElementById('createdAt').textContent = createdAt.toLocaleDateString('fa-IR') + 
                ' ' + createdAt.toLocaleTimeString('fa-IR');
            
            // Update assignment status
            const statusElement = document.getElementById('assignmentStatus');
            const actionsElement = document.getElementById('assignmentActions');
            
            if (account.assignedWorker) {
                statusElement.innerHTML = `
                    <strong>اختصاص یافته به:</strong><br>
                    <span class="badge bg-info">${account.assignedWorker.name}</span><br>
                    <small class="text-muted">${account.assignedWorkerId.substring(0, 8)}...</small>
                `;
                
                actionsElement.innerHTML = `
                    <button class="btn btn-sm btn-outline-warning" onclick="unassignAccount()">
                        <i class="bi bi-arrow-up-right me-1"></i>
                        آزاد کردن
                    </button>
                `;
            } else {
                statusElement.innerHTML = `
                    <span class="text-muted">آزاد</span><br>
                    <small>آماده اختصاص به ورکر</small>
                `;
                
                actionsElement.innerHTML = `
                    <button class="btn btn-sm btn-outline-info" onclick="showAssignOptions()">
                        <i class="bi bi-arrow-down-right me-1"></i>
                        اختصاص به ورکر
                    </button>
                `;
            }
        }

        // Clear session data
        function clearSession() {
            if (confirm('آیا از پاک کردن اطلاعات session اطمینان دارید؟')) {
                document.querySelector('textarea[name="SessionData"]').value = '';
                IvaScanner.showNotification('اطلاعات session پاک شد', 'warning');
            }
        }

        // Test account connection
        function testAccount() {
            const modal = new bootstrap.Modal(document.getElementById('testModal'));
            modal.show();
            
            // Reset modal content
            document.getElementById('testResults').innerHTML = `
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال تست...</span>
                    </div>
                    <p class="mt-2">در حال بررسی اتصال...</p>
                </div>
            `;
            
            // Simulate connection test (would be actual API call)
            setTimeout(() => {
                const success = Math.random() > 0.3; // 70% success rate for demo
                
                if (success) {
                    document.getElementById('testResults').innerHTML = `
                        <div class="alert alert-success">
                            <h6><i class="bi bi-check-circle me-2"></i>اتصال موفق</h6>
                            <p class="mb-2">اکانت به درستی به سرورهای ایوا متصل شد</p>
                            <ul class="mb-0">
                                <li>وضعیت session: معتبر</li>
                                <li>زمان پاسخ: 245ms</li>
                                <li>آخرین فعالیت: ${new Date().toLocaleString('fa-IR')}</li>
                            </ul>
                        </div>
                    `;
                } else {
                    document.getElementById('testResults').innerHTML = `
                        <div class="alert alert-danger">
                            <h6><i class="bi bi-x-circle me-2"></i>خطا در اتصال</h6>
                            <p class="mb-2">امکان اتصال به سرورهای ایوا وجود ندارد</p>
                            <ul class="mb-0">
                                <li>وضعیت session: منقضی یا نامعتبر</li>
                                <li>توصیه: اطلاعات session را بروزرسانی کنید</li>
                                <li>یا اکانت را مجدداً فعال‌سازی کنید</li>
                            </ul>
                        </div>
                    `;
                }
            }, 2000);
        }

        // Account assignment functions
        function unassignAccount() {
            if (confirm('آیا از آزاد کردن این اکانت از ورکر اطمینان دارید؟')) {
                const accountId = '@Model.Id';
                
                fetch(`/api/accounts/${accountId}/unassign`, {
                    method: 'POST'
                })
                .then(response => {
                    if (response.ok) {
                        IvaScanner.showNotification('اکانت آزاد شد', 'success');
                        loadAccountDetails();
                    } else {
                        IvaScanner.showNotification('خطا در آزاد کردن اکانت', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error unassigning account:', error);
                    IvaScanner.showNotification('خطا در آزاد کردن اکانت', 'error');
                });
            }
        }

        function showAssignOptions() {
            // Load available workers and show assignment modal
            IvaScanner.showNotification('قابلیت اختصاص اکانت در صفحه اکانت‌ها در دسترس است', 'info');
        }
    </script>
}
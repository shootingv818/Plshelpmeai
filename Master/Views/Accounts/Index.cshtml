@model IEnumerable<IvaAccount>
@{
    ViewData["Title"] = "اکانت‌های ایوا";
}

<div class="row mb-3">
    <div class="col-md-6">
        <div class="btn-group" role="group">
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="bi bi-plus me-1"></i>
                اکانت جدید
            </a>
            <button type="button" class="btn btn-outline-secondary" onclick="refreshAccounts()">
                <i class="bi bi-arrow-clockwise me-1"></i>
                به‌روزرسانی
            </button>
            <button type="button" class="btn btn-outline-info" onclick="showAccountStats()">
                <i class="bi bi-bar-chart me-1"></i>
                آمار
            </button>
        </div>
    </div>
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" class="form-control" id="searchAccounts" placeholder="جستجو در اکانت‌ها...">
            <button class="btn btn-outline-secondary" type="button">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>
</div>

<!-- Accounts Stats Cards -->
<div class="row mb-4" id="account-stats">
    <div class="col-md-3 mb-3">
        <div class="card text-center bg-success text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-active">0</h4>
                <small>فعال</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center bg-secondary text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-inactive">0</h4>
                <small>غیرفعال</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center bg-warning text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-assigned">0</h4>
                <small>اختصاص یافته</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card text-center bg-info text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-total">@Model.Count()</h4>
                <small>کل</small>
            </div>
        </div>
    </div>
</div>

<!-- Accounts Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-person-badge me-2"></i>
            اکانت‌های ایوا
        </h5>
        <div class="btn-group btn-group-sm">
            <button class="btn btn-outline-secondary" onclick="exportTableToCSV('accountsTable', 'accounts.csv')">
                <i class="bi bi-download me-1"></i>
                خروجی CSV
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="accountsTable">
                    <thead>
                        <tr>
                            <th>شماره تلفن</th>
                            <th>وضعیت</th>
                            <th>ورکر اختصاص یافته</th>
                            <th>آخرین استفاده</th>
                            <th>زمان ایجاد</th>
                            <th>Session</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody id="accounts-table-body">
                        @foreach (var account in Model)
                        {
                            <tr data-account-id="@account.Id">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-telephone me-2 text-muted"></i>
                                        <div>
                                            <strong>@account.PhoneNumber</strong>
                                            <br>
                                            <small class="text-muted">@account.Id.Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        @switch (account.Status)
                                        {
                                            case AccountStatus.Active:
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>
                                                    فعال
                                                </span>
                                                break;
                                            case AccountStatus.Blocked:
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-x-circle me-1"></i>
                                                    مسدود
                                                </span>
                                                break;
                                            case AccountStatus.Error:
                                                <span class="badge bg-warning">
                                                    <i class="bi bi-exclamation-triangle me-1"></i>
                                                    خطا
                                                </span>
                                                break;
                                            case AccountStatus.Expired:
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-clock me-1"></i>
                                                    منقضی
                                                </span>
                                                break;
                                        }
                                        <br>
                                        @if (account.IsActive)
                                        {
                                            <small class="badge bg-outline-success">آماده</small>
                                        }
                                        else
                                        {
                                            <small class="badge bg-outline-secondary">غیرفعال</small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (account.AssignedWorker != null)
                                    {
                                        <div>
                                            <span class="badge bg-info">@account.AssignedWorker.Name</span>
                                            <br>
                                            <small class="text-muted">@account.AssignedWorkerId.Substring(0, 8)...</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">آزاد</span>
                                    }
                                </td>
                                <td>
                                    <div>
                                        @account.LastUsed.ToString("yyyy/MM/dd")
                                        <br>
                                        <small class="text-muted">@account.LastUsed.ToString("HH:mm:ss")</small>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        @account.CreatedAt.ToString("yyyy/MM/dd")
                                        <br>
                                        <small class="text-muted">@account.CreatedAt.ToString("HH:mm:ss")</small>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(account.SessionData))
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check me-1"></i>
                                            دارد
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="bi bi-x me-1"></i>
                                            ندارد
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Edit", new { id = account.Id })" 
                                           class="btn btn-outline-primary" title="ویرایش">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        
                                        @if (account.IsActive)
                                        {
                                            <button type="button" class="btn btn-outline-warning" 
                                                    onclick="toggleAccount('@account.Id', false)" title="غیرفعال">
                                                <i class="bi bi-pause"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-success" 
                                                    onclick="toggleAccount('@account.Id', true)" title="فعال">
                                                <i class="bi bi-play"></i>
                                            </button>
                                        }

                                        @if (account.AssignedWorker != null)
                                        {
                                            <button type="button" class="btn btn-outline-info" 
                                                    onclick="unassignAccount('@account.Id')" title="آزاد کردن">
                                                <i class="bi bi-arrow-up-right"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-outline-info" 
                                                    onclick="showAssignModal('@account.Id')" title="اختصاص">
                                                <i class="bi bi-arrow-down-right"></i>
                                            </button>
                                        }
                                        
                                        <button type="button" class="btn btn-outline-danger" 
                                                onclick="deleteAccount('@account.Id')" title="حذف">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-person-badge mb-3" style="font-size: 3rem;"></i>
                <h5>هیچ اکانت ایوایی یافت نشد</h5>
                <p>برای شروع کار، یک اکانت ایوا جدید ایجاد کنید.</p>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="bi bi-plus me-1"></i>
                    اکانت جدید
                </a>
            </div>
        }
    </div>
</div>

<!-- Worker Assignment Modal -->
<div class="modal fade" id="assignModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">اختصاص اکانت به ورکر</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="assignForm">
                    <input type="hidden" id="assignAccountId">
                    <div class="mb-3">
                        <label class="form-label">ورکر:</label>
                        <select class="form-select" id="assignWorkerId" required>
                            <option value="">انتخاب کنید...</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="assignAccount()">اختصاص</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Real-time updates
        function refreshAccounts() {
            fetch('/Accounts/GetAccountsJson')
                .then(response => response.json())
                .then(accounts => {
                    if (!accounts.error) {
                        updateAccountsTable(accounts);
                        updateAccountStats();
                    }
                })
                .catch(error => console.error('Error refreshing accounts:', error));
        }

        function updateAccountsTable(accounts) {
            const tbody = document.getElementById('accounts-table-body');
            if (!tbody) return;

            tbody.innerHTML = '';
            accounts.forEach(account => {
                const row = createAccountRow(account);
                tbody.appendChild(row);
            });

            document.getElementById('stat-total').textContent = accounts.length;
        }

        function createAccountRow(account) {
            const row = document.createElement('tr');
            row.setAttribute('data-account-id', account.id);
            
            const statusBadge = getAccountStatusBadge(account.status);
            const assignedWorker = account.assignedWorker ? 
                `<div>
                    <span class="badge bg-info">${account.assignedWorker.name}</span><br>
                    <small class="text-muted">${account.assignedWorkerId.substring(0, 8)}...</small>
                </div>` : 
                '<span class="text-muted">آزاد</span>';
            
            row.innerHTML = `
                <td>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-telephone me-2 text-muted"></i>
                        <div>
                            <strong>${account.phoneNumber}</strong><br>
                            <small class="text-muted">${account.id.substring(0, 8)}...</small>
                        </div>
                    </div>
                </td>
                <td>
                    <div>
                        ${statusBadge}<br>
                        ${account.isActive ? 
                            '<small class="badge bg-outline-success">آماده</small>' : 
                            '<small class="badge bg-outline-secondary">غیرفعال</small>'
                        }
                    </div>
                </td>
                <td>${assignedWorker}</td>
                <td>
                    <div>
                        ${new Date(account.lastUsed).toLocaleDateString('fa-IR')}<br>
                        <small class="text-muted">${new Date(account.lastUsed).toLocaleTimeString('fa-IR')}</small>
                    </div>
                </td>
                <td>
                    <div>
                        ${new Date(account.createdAt).toLocaleDateString('fa-IR')}<br>
                        <small class="text-muted">${new Date(account.createdAt).toLocaleTimeString('fa-IR')}</small>
                    </div>
                </td>
                <td>
                    ${account.sessionData ? 
                        '<span class="badge bg-success"><i class="bi bi-check me-1"></i>دارد</span>' : 
                        '<span class="badge bg-secondary"><i class="bi bi-x me-1"></i>ندارد</span>'
                    }
                </td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <a href="/Accounts/Edit/${account.id}" class="btn btn-outline-primary" title="ویرایش">
                            <i class="bi bi-pencil"></i>
                        </a>
                        ${getAccountActionButtons(account)}
                        <button type="button" class="btn btn-outline-danger" onclick="deleteAccount('${account.id}')" title="حذف">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </td>
            `;
            
            return row;
        }

        function getAccountStatusBadge(status) {
            const statusMap = {
                'Active': '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> فعال</span>',
                'Blocked': '<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> مسدود</span>',
                'Error': '<span class="badge bg-warning"><i class="bi bi-exclamation-triangle me-1"></i> خطا</span>',
                'Expired': '<span class="badge bg-secondary"><i class="bi bi-clock me-1"></i> منقضی</span>'
            };
            return statusMap[status] || `<span class="badge bg-info">${status}</span>`;
        }

        function getAccountActionButtons(account) {
            let buttons = '';
            
            if (account.isActive) {
                buttons += `<button type="button" class="btn btn-outline-warning" onclick="toggleAccount('${account.id}', false)" title="غیرفعال">
                    <i class="bi bi-pause"></i>
                </button>`;
            } else {
                buttons += `<button type="button" class="btn btn-outline-success" onclick="toggleAccount('${account.id}', true)" title="فعال">
                    <i class="bi bi-play"></i>
                </button>`;
            }
            
            if (account.assignedWorker) {
                buttons += `<button type="button" class="btn btn-outline-info" onclick="unassignAccount('${account.id}')" title="آزاد کردن">
                    <i class="bi bi-arrow-up-right"></i>
                </button>`;
            } else {
                buttons += `<button type="button" class="btn btn-outline-info" onclick="showAssignModal('${account.id}')" title="اختصاص">
                    <i class="bi bi-arrow-down-right"></i>
                </button>`;
            }
            
            return buttons;
        }

        function updateAccountStats() {
            fetch('/Accounts/GetAccountStats')
                .then(response => response.json())
                .then(stats => {
                    if (!stats.error) {
                        document.getElementById('stat-active').textContent = stats.active || 0;
                        document.getElementById('stat-inactive').textContent = stats.inactive || 0;
                        document.getElementById('stat-assigned').textContent = stats.withSession || 0;
                        document.getElementById('stat-total').textContent = stats.total || 0;
                    }
                })
                .catch(error => console.error('Error updating account stats:', error));
        }

        function showAccountStats() {
            updateAccountStats();
        }

        // Account actions
        function toggleAccount(accountId, activate) {
            fetch(`/Accounts/Toggle/${accountId}`, {
                method: 'POST'
            })
            .then(response => {
                if (response.ok) {
                    refreshAccounts();
                    const message = activate ? 'اکانت فعال شد' : 'اکانت غیرفعال شد';
                    IvaScanner.showNotification(message, 'success');
                } else {
                    IvaScanner.showNotification('خطا در تغییر وضعیت اکانت', 'error');
                }
            })
            .catch(error => {
                console.error('Error toggling account:', error);
                IvaScanner.showNotification('خطا در تغییر وضعیت اکانت', 'error');
            });
        }

        function deleteAccount(accountId) {
            if (confirm('آیا از حذف این اکانت اطمینان دارید؟')) {
                fetch(`/Accounts/Delete/${accountId}`, {
                    method: 'POST'
                })
                .then(response => {
                    if (response.ok) {
                        refreshAccounts();
                        IvaScanner.showNotification('اکانت با موفقیت حذف شد', 'success');
                    } else {
                        IvaScanner.showNotification('خطا در حذف اکانت', 'error');
                    }
                })
                .catch(error => {
                    console.error('Error deleting account:', error);
                    IvaScanner.showNotification('خطا در حذف اکانت', 'error');
                });
            }
        }

        function showAssignModal(accountId) {
            document.getElementById('assignAccountId').value = accountId;
            
            // Load available workers
            fetch('/Workers/GetWorkersJson')
                .then(response => response.json())
                .then(workers => {
                    const select = document.getElementById('assignWorkerId');
                    select.innerHTML = '<option value="">انتخاب کنید...</option>';
                    
                    workers.forEach(worker => {
                        if (!worker.ivaAccountId && worker.status === 'Online') {
                            const option = document.createElement('option');
                            option.value = worker.id;
                            option.textContent = `${worker.name} (${worker.id.substring(0, 8)}...)`;
                            select.appendChild(option);
                        }
                    });
                    
                    new bootstrap.Modal(document.getElementById('assignModal')).show();
                })
                .catch(error => console.error('Error loading workers:', error));
        }

        function assignAccount() {
            const accountId = document.getElementById('assignAccountId').value;
            const workerId = document.getElementById('assignWorkerId').value;
            
            if (!workerId) {
                IvaScanner.showNotification('لطفاً ورکر را انتخاب کنید', 'warning');
                return;
            }
            
            const formData = new FormData();
            formData.append('workerId', workerId);
            formData.append('accountId', accountId);
            
            fetch(`/Workers/AssignAccount`, {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('assignModal')).hide();
                    refreshAccounts();
                    IvaScanner.showNotification('اکانت با موفقیت اختصاص یافت', 'success');
                } else {
                    IvaScanner.showNotification('خطا در اختصاص اکانت', 'error');
                }
            })
            .catch(error => {
                console.error('Error assigning account:', error);
                IvaScanner.showNotification('خطا در اختصاص اکانت', 'error');
            });
        }

        function unassignAccount(accountId) {
            if (confirm('آیا از آزاد کردن این اکانت اطمینان دارید؟')) {
                // Implementation depends on API
                IvaScanner.showNotification('قابلیت آزاد کردن اکانت در حال پیاده‌سازی است', 'info');
            }
        }

        // Search functionality
        document.getElementById('searchAccounts').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#accounts-table-body tr');
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });

        // Auto-refresh every 60 seconds
        setInterval(refreshAccounts, 60000);
        
        // Initial stats load
        updateAccountStats();
    </script>
}
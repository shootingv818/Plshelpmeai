@model IEnumerable<ScanJob>
@{
    ViewData["Title"] = "اسکن کارت‌ها";
}

<div class="row mb-3">
    <div class="col-md-6">
        <div class="btn-group" role="group">
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="bi bi-plus me-1"></i>
                اسکن جدید
            </a>
            <button type="button" class="btn btn-outline-secondary" onclick="refreshScans()">
                <i class="bi bi-arrow-clockwise me-1"></i>
                به‌روزرسانی
            </button>
            <button type="button" class="btn btn-outline-info" onclick="showScanStats()">
                <i class="bi bi-bar-chart me-1"></i>
                آمار
            </button>
        </div>
    </div>
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" class="form-control" id="searchScans" placeholder="جستجو در اسکن‌ها...">
            <button class="btn btn-outline-secondary" type="button">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>
</div>

<!-- Scan Stats Cards -->
<div class="row mb-4" id="scan-stats">
    <div class="col-md-2 mb-3">
        <div class="card text-center bg-primary text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-active">0</h4>
                <small>فعال</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-center bg-success text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-completed">0</h4>
                <small>تکمیل شده</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-center bg-danger text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-failed">0</h4>
                <small>ناموفق</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-center bg-warning text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-paused">0</h4>
                <small>متوقف</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-center bg-secondary text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-cancelled">0</h4>
                <small>لغو شده</small>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-center bg-info text-white">
            <div class="card-body">
                <h4 class="mb-1" id="stat-total">@Model.Count()</h4>
                <small>کل</small>
            </div>
        </div>
    </div>
</div>

<!-- Scans Table -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">
            <i class="bi bi-search me-2"></i>
            لیست اسکن‌ها
        </h5>
        <div class="btn-group btn-group-sm">
            <button class="btn btn-outline-secondary" onclick="exportTableToCSV('scansTable', 'scans.csv')">
                <i class="bi bi-download me-1"></i>
                خروجی CSV
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="scansTable">
                    <thead>
                        <tr>
                            <th>شماره کارت</th>
                            <th>وضعیت</th>
                            <th>پیشرفت</th>
                            <th>تسک‌ها</th>
                            <th>زمان ایجاد</th>
                            <th>زمان تکمیل</th>
                            <th>نتیجه</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody id="scans-table-body">
                        @foreach (var job in Model)
                        {
                            <tr data-job-id="@job.Id">
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-credit-card me-2 text-muted"></i>
                                        <div>
                                            <code class="fw-bold">@job.CardNumber</code>
                                            <br>
                                            <small class="text-muted">@job.Id.Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    @switch (job.Status)
                                    {
                                        case ScanJobStatus.Running:
                                            <span class="badge bg-primary">
                                                <i class="bi bi-play-fill me-1"></i>
                                                در حال اجرا
                                            </span>
                                            break;
                                        case ScanJobStatus.Completed:
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                تکمیل شده
                                            </span>
                                            break;
                                        case ScanJobStatus.Failed:
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle me-1"></i>
                                                ناموفق
                                            </span>
                                            break;
                                        case ScanJobStatus.Paused:
                                            <span class="badge bg-warning">
                                                <i class="bi bi-pause-fill me-1"></i>
                                                متوقف
                                            </span>
                                            break;
                                        case ScanJobStatus.Cancelled:
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-stop-fill me-1"></i>
                                                لغو شده
                                            </span>
                                            break;
                                        case ScanJobStatus.Queued:
                                            <span class="badge bg-info">
                                                <i class="bi bi-hourglass me-1"></i>
                                                در انتظار
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark">@job.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="progress mb-1" style="height: 20px;">
                                        <div class="progress-bar @(job.Status == ScanJobStatus.Running ? "progress-bar-striped progress-bar-animated" : "")"
                                             role="progressbar" 
                                             style="width: @(job.Progress)%;"
                                             aria-valuenow="@job.Progress" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                            @(job.Progress)%
                                        </div>
                                    </div>
                                    <small class="text-muted">@job.CompletedTasks / @job.TotalTasks تسک</small>
                                </td>
                                <td>
                                    <div class="text-center">
                                        <div>
                                            <span class="badge bg-info">@job.TotalTasks</span>
                                            <small class="text-muted d-block">کل</small>
                                        </div>
                                        <div class="mt-1">
                                            <span class="badge bg-success">@job.CompletedTasks</span>
                                            <span class="badge bg-danger">@job.FailedTasks</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div>
                                        @job.CreatedAt.ToString("yyyy/MM/dd")
                                        <br>
                                        <small class="text-muted">@job.CreatedAt.ToString("HH:mm:ss")</small>
                                    </div>
                                </td>
                                <td>
                                    @if (job.CompletedAt.HasValue)
                                    {
                                        <div>
                                            @job.CompletedAt.Value.ToString("yyyy/MM/dd")
                                            <br>
                                            <small class="text-muted">@job.CompletedAt.Value.ToString("HH:mm:ss")</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(job.Result))
                                    {
                                        <button class="btn btn-sm btn-outline-success" onclick="showResult('@job.Id')">
                                            <i class="bi bi-eye me-1"></i>
                                            مشاهده
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Details", new { id = job.Id })" 
                                           class="btn btn-outline-info" title="جزئیات">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        
                                        @if (job.Status == ScanJobStatus.Running)
                                        {
                                            <button type="button" class="btn btn-outline-warning" 
                                                    onclick="pauseJob('@job.Id')" title="توقف">
                                                <i class="bi bi-pause"></i>
                                            </button>
                                        }
                                        else if (job.Status == ScanJobStatus.Paused)
                                        {
                                            <button type="button" class="btn btn-outline-success" 
                                                    onclick="resumeJob('@job.Id')" title="ادامه">
                                                <i class="bi bi-play"></i>
                                            </button>
                                        }
                                        
                                        @if (job.Status == ScanJobStatus.Running || job.Status == ScanJobStatus.Paused || job.Status == ScanJobStatus.Queued)
                                        {
                                            <button type="button" class="btn btn-outline-danger" 
                                                    onclick="cancelJob('@job.Id')" title="لغو">
                                                <i class="bi bi-stop"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-search mb-3" style="font-size: 3rem;"></i>
                <h5>هیچ اسکنی یافت نشد</h5>
                <p>برای شروع اسکن کارت، یک اسکن جدید ایجاد کنید.</p>
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="bi bi-plus me-1"></i>
                    اسکن جدید
                </a>
            </div>
        }
    </div>
</div>

<!-- Result Modal -->
<div class="modal fade" id="resultModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">نتیجه اسکن</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="resultModalBody">
                <!-- Result content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                <button type="button" class="btn btn-primary" onclick="copyResult()">
                    <i class="bi bi-clipboard me-1"></i>
                    کپی
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentResultData = null;

        // Real-time updates
        function refreshScans() {
            fetch('/Scan/GetJobsJson')
                .then(response => response.json())
                .then(jobs => {
                    if (!jobs.error) {
                        updateScansTable(jobs);
                        updateScanStats();
                    }
                })
                .catch(error => console.error('Error refreshing scans:', error));
        }

        function updateScansTable(jobs) {
            const tbody = document.getElementById('scans-table-body');
            if (!tbody) return;

            tbody.innerHTML = '';
            jobs.forEach(job => {
                const row = createScanRow(job);
                tbody.appendChild(row);
            });

            document.getElementById('stat-total').textContent = jobs.length;
        }

        function createScanRow(job) {
            const row = document.createElement('tr');
            row.setAttribute('data-job-id', job.id);
            
            const statusBadge = getScanStatusBadge(job.status);
            const progressBar = createProgressBar(job.progress, job.status === 'Running');
            
            row.innerHTML = `
                <td>
                    <div class="d-flex align-items-center">
                        <i class="bi bi-credit-card me-2 text-muted"></i>
                        <div>
                            <code class="fw-bold">${job.cardNumber}</code><br>
                            <small class="text-muted">${job.id.substring(0, 8)}...</small>
                        </div>
                    </div>
                </td>
                <td>${statusBadge}</td>
                <td>
                    ${progressBar}
                    <small class="text-muted">${job.completedTasks} / ${job.totalTasks} تسک</small>
                </td>
                <td>
                    <div class="text-center">
                        <div>
                            <span class="badge bg-info">${job.totalTasks}</span>
                            <small class="text-muted d-block">کل</small>
                        </div>
                        <div class="mt-1">
                            <span class="badge bg-success">${job.completedTasks}</span>
                            <span class="badge bg-danger">${job.failedTasks || 0}</span>
                        </div>
                    </div>
                </td>
                <td>
                    <div>
                        ${new Date(job.createdAt).toLocaleDateString('fa-IR')}<br>
                        <small class="text-muted">${new Date(job.createdAt).toLocaleTimeString('fa-IR')}</small>
                    </div>
                </td>
                <td>
                    ${job.completedAt ? 
                        `<div>
                            ${new Date(job.completedAt).toLocaleDateString('fa-IR')}<br>
                            <small class="text-muted">${new Date(job.completedAt).toLocaleTimeString('fa-IR')}</small>
                        </div>` : 
                        '<span class="text-muted">-</span>'
                    }
                </td>
                <td>
                    ${job.result ? 
                        `<button class="btn btn-sm btn-outline-success" onclick="showResult('${job.id}')">
                            <i class="bi bi-eye me-1"></i>مشاهده
                        </button>` : 
                        '<span class="text-muted">-</span>'
                    }
                </td>
                <td>
                    <div class="btn-group btn-group-sm">
                        <a href="/Scan/Details/${job.id}" class="btn btn-outline-info" title="جزئیات">
                            <i class="bi bi-eye"></i>
                        </a>
                        ${getJobActionButtons(job)}
                    </div>
                </td>
            `;
            
            return row;
        }

        function getScanStatusBadge(status) {
            const statusMap = {
                'Running': '<span class="badge bg-primary"><i class="bi bi-play-fill me-1"></i> در حال اجرا</span>',
                'Completed': '<span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> تکمیل شده</span>',
                'Failed': '<span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> ناموفق</span>',
                'Paused': '<span class="badge bg-warning"><i class="bi bi-pause-fill me-1"></i> متوقف</span>',
                'Cancelled': '<span class="badge bg-secondary"><i class="bi bi-stop-fill me-1"></i> لغو شده</span>',
                'Queued': '<span class="badge bg-info"><i class="bi bi-hourglass me-1"></i> در انتظار</span>'
            };
            return statusMap[status] || `<span class="badge bg-light text-dark">${status}</span>`;
        }

        function createProgressBar(progress, animated = false) {
            const animationClass = animated ? 'progress-bar-striped progress-bar-animated' : '';
            return `
                <div class="progress mb-1" style="height: 20px;">
                    <div class="progress-bar ${animationClass}" role="progressbar" 
                         style="width: ${progress}%;" aria-valuenow="${progress}" 
                         aria-valuemin="0" aria-valuemax="100">
                        ${progress}%
                    </div>
                </div>
            `;
        }

        function getJobActionButtons(job) {
            let buttons = '';
            
            if (job.status === 'Running') {
                buttons += `<button type="button" class="btn btn-outline-warning" onclick="pauseJob('${job.id}')" title="توقف">
                    <i class="bi bi-pause"></i>
                </button>`;
            } else if (job.status === 'Paused') {
                buttons += `<button type="button" class="btn btn-outline-success" onclick="resumeJob('${job.id}')" title="ادامه">
                    <i class="bi bi-play"></i>
                </button>`;
            }
            
            if (['Running', 'Paused', 'Queued'].includes(job.status)) {
                buttons += `<button type="button" class="btn btn-outline-danger" onclick="cancelJob('${job.id}')" title="لغو">
                    <i class="bi bi-stop"></i>
                </button>`;
            }
            
            return buttons;
        }

        function updateScanStats() {
            fetch('/Scan/GetScanStats')
                .then(response => response.json())
                .then(stats => {
                    if (!stats.error) {
                        document.getElementById('stat-active').textContent = stats.active || 0;
                        document.getElementById('stat-completed').textContent = stats.completed || 0;
                        document.getElementById('stat-failed').textContent = stats.failed || 0;
                        document.getElementById('stat-cancelled').textContent = stats.cancelled || 0;
                        document.getElementById('stat-total').textContent = stats.total || 0;
                    }
                })
                .catch(error => console.error('Error updating scan stats:', error));
        }

        function showScanStats() {
            updateScanStats();
        }

        // Job actions
        function pauseJob(jobId) {
            if (confirm('آیا از توقف این اسکن اطمینان دارید؟')) {
                performJobAction(jobId, 'pause', 'توقف');
            }
        }

        function resumeJob(jobId) {
            performJobAction(jobId, 'resume', 'ادامه');
        }

        function cancelJob(jobId) {
            if (confirm('آیا از لغو این اسکن اطمینان دارید؟ این عمل قابل برگشت نیست.')) {
                performJobAction(jobId, 'cancel', 'لغو');
            }
        }

        function performJobAction(jobId, action, actionName) {
            fetch(`/Scan/${action.charAt(0).toUpperCase() + action.slice(1)}/${jobId}`, {
                method: 'POST'
            })
            .then(response => {
                if (response.ok) {
                    refreshScans();
                    IvaScanner.showNotification(`اسکن با موفقیت ${actionName} شد`, 'success');
                } else {
                    IvaScanner.showNotification(`خطا در ${actionName} اسکن`, 'error');
                }
            })
            .catch(error => {
                console.error(`Error ${action}ing job:`, error);
                IvaScanner.showNotification(`خطا در ${actionName} اسکن`, 'error');
            });
        }

        // Show result modal
        function showResult(jobId) {
            fetch(`/Scan/GetJobProgress/${jobId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.error) {
                        IvaScanner.showNotification('خطا در دریافت نتیجه', 'error');
                        return;
                    }
                    
                    currentResultData = data;
                    displayResult(data);
                })
                .catch(error => {
                    console.error('Error fetching job result:', error);
                    IvaScanner.showNotification('خطا در دریافت نتیجه', 'error');
                });
        }

        function displayResult(data) {
            const modalBody = document.getElementById('resultModalBody');
            
            let resultHtml = `
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>شناسه اسکن:</strong> ${data.jobId}
                    </div>
                    <div class="col-md-6">
                        <strong>وضعیت:</strong> ${getScanStatusBadge(data.status)}
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>پیشرفت:</strong> ${data.progressPercentage}%
                    </div>
                    <div class="col-md-6">
                        <strong>تسک‌ها:</strong> ${data.completedTasks} / ${data.totalTasks}
                    </div>
                </div>
            `;
            
            if (data.detectedExpiry) {
                resultHtml += `
                    <div class="alert alert-info">
                        <h6><i class="bi bi-calendar me-2"></i>تاریخ انقضا تشخیص داده شد</h6>
                        <p class="mb-0"><strong>تاریخ انقضا:</strong> ${data.detectedExpiry}</p>
                        ${data.expiryDetectedAt ? `<small class="text-muted">زمان تشخیص: ${new Date(data.expiryDetectedAt).toLocaleString('fa-IR')}</small>` : ''}
                    </div>
                `;
            }
            
            if (data.finalResult) {
                try {
                    const result = JSON.parse(data.finalResult);
                    if (result.Success && result.ValidCvv) {
                        resultHtml += `
                            <div class="alert alert-success">
                                <h6><i class="bi bi-check-circle me-2"></i>CVV معتبر یافت شد!</h6>
                                <p class="mb-2"><strong>CVV:</strong> <code class="fs-5">${result.ValidCvv}</code></p>
                                ${result.CardInfo ? `<p class="mb-0"><strong>اطلاعات کارت:</strong> <pre>${JSON.stringify(result.CardInfo, null, 2)}</pre></p>` : ''}
                            </div>
                        `;
                    }
                } catch (e) {
                    resultHtml += `
                        <div class="alert alert-secondary">
                            <h6><i class="bi bi-file-text me-2"></i>نتیجه خام</h6>
                            <pre>${data.finalResult}</pre>
                        </div>
                    `;
                }
            }
            
            if (data.estimatedTimeRemaining) {
                resultHtml += `
                    <div class="row mt-3">
                        <div class="col-12">
                            <strong>زمان تخمینی باقی‌مانده:</strong> ${formatDuration(data.estimatedTimeRemaining)}
                        </div>
                    </div>
                `;
            }
            
            modalBody.innerHTML = resultHtml;
            new bootstrap.Modal(document.getElementById('resultModal')).show();
        }

        function copyResult() {
            if (currentResultData) {
                const text = JSON.stringify(currentResultData, null, 2);
                IvaScanner.copyToClipboard(text);
            }
        }

        // Search functionality
        document.getElementById('searchScans').addEventListener('input', function(e) {
            const searchTerm = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#scans-table-body tr');
            
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(searchTerm) ? '' : 'none';
            });
        });

        // Auto-refresh every 10 seconds
        setInterval(refreshScans, 10000);
        
        // Initial stats load
        updateScanStats();
        
        // Make functions globally available
        window.refreshScans = refreshScans;
    </script>
}
@model ScanJob
@{
    ViewData["Title"] = "نتایج اسکن";
}

<div class="row">
    <!-- Header -->
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">
                        <i class="bi bi-trophy me-2"></i>
                        نتایج اسکن #@Model.Id
                    </h5>
                    <small class="text-muted">
                        کارت: @Model.CardNumber.Substring(0, 4) **** **** @Model.CardNumber.Substring(12, 4)
                        | تکمیل شده در @Model.CompletedAt?.ToString("yyyy/MM/dd HH:mm")
                    </small>
                </div>
                <div>
                    <button class="btn btn-outline-success" onclick="exportResults('excel')">
                        <i class="bi bi-file-earmark-excel me-1"></i>
                        اکسل
                    </button>
                    <button class="btn btn-outline-info ms-2" onclick="exportResults('json')">
                        <i class="bi bi-filetype-json me-1"></i>
                        JSON
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Summary Cards -->
    <div class="col-md-3">
        <div class="card text-center border-success">
            <div class="card-body">
                <h2 class="text-success mb-1" id="totalFound">0</h2>
                <small class="text-muted">کارت پیدا شده</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-primary">
            <div class="card-body">
                <h2 class="text-primary mb-1" id="totalTested">@Model.TotalTasks</h2>
                <small class="text-muted">تسک تست شده</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-info">
            <div class="card-body">
                <h2 class="text-info mb-1" id="successRate">0%</h2>
                <small class="text-muted">نرخ موفقیت</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-warning">
            <div class="card-body">
                <h2 class="text-warning mb-1" id="totalTime">@GetScanDuration(Model)</h2>
                <small class="text-muted">زمان اسکن</small>
            </div>
        </div>
    </div>
</div>

<!-- Results Filter -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-funnel me-2"></i>
                    فیلتر و جستجو
                </h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" id="searchInput" 
                                   placeholder="جستجو در شماره تلفن، پسورد یا CVV...">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="statusFilter">
                            <option value="">همه وضعیت‌ها</option>
                            <option value="success">موفق</option>
                            <option value="failed">ناموفق</option>
                            <option value="partial">جزئی</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select" id="typeFilter">
                            <option value="">همه انواع</option>
                            <option value="expiry">تاریخ انقضا</option>
                            <option value="cvv">CVV</option>
                            <option value="password">پسورد</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                            <i class="bi bi-x-circle me-1"></i>
                            پاک کردن
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Results Table -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <h6 class="mb-0">
                    <i class="bi bi-table me-2"></i>
                    نتایج تفصیلی
                </h6>
                <div>
                    <span class="text-muted" id="resultsCount">0 نتیجه</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="resultsTable">
                        <thead class="table-light">
                            <tr>
                                <th width="5%">#</th>
                                <th width="15%">شماره تلفن</th>
                                <th width="10%">وضعیت</th>
                                <th width="15%">نوع تست</th>
                                <th width="15%">پسورد/CVV</th>
                                <th width="15%">تاریخ انقضا</th>
                                <th width="10%">ورکر</th>
                                <th width="15%">زمان</th>
                            </tr>
                        </thead>
                        <tbody id="resultsTableBody">
                            <!-- Results will be loaded here -->
                        </tbody>
                    </table>
                </div>
                
                <!-- Loading State -->
                <div id="loadingState" class="text-center p-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">در حال بارگذاری...</span>
                    </div>
                    <p class="mt-2 text-muted">در حال بارگذاری نتایج...</p>
                </div>
                
                <!-- Empty State -->
                <div id="emptyState" class="text-center p-4" style="display: none;">
                    <i class="bi bi-inbox display-1 text-muted"></i>
                    <h5 class="mt-3 text-muted">هیچ نتیجه‌ای یافت نشد</h5>
                    <p class="text-muted">فیلترها را تغییر دهید یا منتظر تکمیل اسکن بمانید</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pagination -->
<div class="row mt-3">
    <div class="col-12">
        <nav aria-label="Results pagination">
            <ul class="pagination justify-content-center" id="pagination">
                <!-- Pagination will be generated here -->
            </ul>
        </nav>
    </div>
</div>

@functions {
    private string GetScanDuration(ScanJob job)
    {
        if (job.StartedAt == null || job.CompletedAt == null) return "نامشخص";
        
        var duration = job.CompletedAt.Value - job.StartedAt.Value;
        if (duration.TotalHours >= 1)
            return $"{duration.Hours}:{duration.Minutes:00}:{duration.Seconds:00}";
        else
            return $"{duration.Minutes}:{duration.Seconds:00}";
    }
}

@section Scripts {
    <script>
        let currentPage = 1;
        let totalPages = 1;
        let allResults = [];
        let filteredResults = [];
        const pageSize = 20;

        document.addEventListener('DOMContentLoaded', function() {
            loadResults();
            setupEventListeners();
        });

        function setupEventListeners() {
            document.getElementById('searchInput').addEventListener('input', debounce(filterResults, 300));
            document.getElementById('statusFilter').addEventListener('change', filterResults);
            document.getElementById('typeFilter').addEventListener('change', filterResults);
        }

        function loadResults() {
            fetch(`/api/jobs/@Model.Id/results`)
                .then(response => response.json())
                .then(data => {
                    allResults = data.results || [];
                    updateSummary(data.summary);
                    filterResults();
                    hideLoading();
                })
                .catch(error => {
                    console.error('Error loading results:', error);
                    showError('خطا در بارگذاری نتایج');
                    hideLoading();
                });
        }

        function updateSummary(summary) {
            document.getElementById('totalFound').textContent = summary.totalFound || 0;
            document.getElementById('totalTested').textContent = summary.totalTested || 0;
            
            const successRate = summary.totalTested > 0 ? 
                Math.round((summary.totalFound / summary.totalTested) * 100) : 0;
            document.getElementById('successRate').textContent = successRate + '%';
        }

        function filterResults() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const statusFilter = document.getElementById('statusFilter').value;
            const typeFilter = document.getElementById('typeFilter').value;

            filteredResults = allResults.filter(result => {
                // Search filter
                const matchesSearch = !searchTerm || 
                    result.phoneNumber.includes(searchTerm) ||
                    (result.password && result.password.toLowerCase().includes(searchTerm)) ||
                    (result.cvv && result.cvv.includes(searchTerm));

                // Status filter
                const matchesStatus = !statusFilter || result.status === statusFilter;

                // Type filter  
                const matchesType = !typeFilter || result.testType === typeFilter;

                return matchesSearch && matchesStatus && matchesType;
            });

            currentPage = 1;
            displayResults();
            updatePagination();
        }

        function displayResults() {
            const tbody = document.getElementById('resultsTableBody');
            const startIndex = (currentPage - 1) * pageSize;
            const endIndex = startIndex + pageSize;
            const pageResults = filteredResults.slice(startIndex, endIndex);

            if (pageResults.length === 0 && filteredResults.length === 0) {
                document.getElementById('emptyState').style.display = 'block';
                tbody.innerHTML = '';
                return;
            }

            document.getElementById('emptyState').style.display = 'none';
            
            tbody.innerHTML = pageResults.map((result, index) => {
                const globalIndex = startIndex + index + 1;
                return createResultRow(result, globalIndex);
            }).join('');

            document.getElementById('resultsCount').textContent = 
                `${filteredResults.length} نتیجه${filteredResults.length !== allResults.length ? ` از ${allResults.length}` : ''}`;
        }

        function createResultRow(result, index) {
            const statusBadge = getStatusBadge(result.status);
            const testTypeBadge = getTestTypeBadge(result.testType);
            
            return `
                <tr class="result-row" data-result-id="${result.id}">
                    <td>${index}</td>
                    <td>
                        <strong>${result.phoneNumber}</strong>
                        ${result.accountName ? `<br><small class="text-muted">${result.accountName}</small>` : ''}
                    </td>
                    <td>${statusBadge}</td>
                    <td>${testTypeBadge}</td>
                    <td>
                        ${result.password ? 
                            `<code class="password-field" onclick="togglePasswordVisibility(this)">${'*'.repeat(result.password.length)}</code>
                             <span class="password-value" style="display:none;">${result.password}</span>` : 
                            '-'
                        }
                        ${result.cvv ? `<br><small class="text-muted">CVV: ${result.cvv}</small>` : ''}
                    </td>
                    <td>
                        ${result.expiryMonth && result.expiryYear ? 
                            `${result.expiryMonth.toString().padStart(2, '0')}/${result.expiryYear.toString().substr(-2)}` : 
                            '-'
                        }
                    </td>
                    <td>
                        <small class="text-muted">${result.workerName || 'نامشخص'}</small>
                    </td>
                    <td>
                        <small class="text-muted">${formatDateTime(result.createdAt)}</small>
                    </td>
                </tr>
            `;
        }

        function getStatusBadge(status) {
            const badges = {
                'success': '<span class="badge bg-success">موفق</span>',
                'failed': '<span class="badge bg-danger">ناموفق</span>', 
                'partial': '<span class="badge bg-warning">جزئی</span>'
            };
            return badges[status] || '<span class="badge bg-secondary">نامشخص</span>';
        }

        function getTestTypeBadge(testType) {
            const badges = {
                'expiry': '<span class="badge bg-info">انقضا</span>',
                'cvv': '<span class="badge bg-primary">CVV</span>',
                'password': '<span class="badge bg-success">پسورد</span>'
            };
            return badges[testType] || '<span class="badge bg-secondary">عمومی</span>';
        }

        function togglePasswordVisibility(element) {
            const passwordField = element;
            const passwordValue = element.nextElementSibling;
            
            if (passwordValue.style.display === 'none') {
                passwordField.style.display = 'none';
                passwordValue.style.display = 'inline';
            } else {
                passwordField.style.display = 'inline';
                passwordValue.style.display = 'none';
            }
        }

        function updatePagination() {
            totalPages = Math.ceil(filteredResults.length / pageSize);
            const pagination = document.getElementById('pagination');

            if (totalPages <= 1) {
                pagination.innerHTML = '';
                return;
            }

            let paginationHtml = '';

            // Previous button
            paginationHtml += `
                <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage - 1})">قبلی</a>
                </li>
            `;

            // Page numbers
            const startPage = Math.max(1, currentPage - 2);
            const endPage = Math.min(totalPages, currentPage + 2);

            if (startPage > 1) {
                paginationHtml += '<li class="page-item"><a class="page-link" href="#" onclick="changePage(1)">1</a></li>';
                if (startPage > 2) {
                    paginationHtml += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                }
            }

            for (let i = startPage; i <= endPage; i++) {
                paginationHtml += `
                    <li class="page-item ${i === currentPage ? 'active' : ''}">
                        <a class="page-link" href="#" onclick="changePage(${i})">${i}</a>
                    </li>
                `;
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    paginationHtml += '<li class="page-item disabled"><span class="page-link">...</span></li>';
                }
                paginationHtml += `<li class="page-item"><a class="page-link" href="#" onclick="changePage(${totalPages})">${totalPages}</a></li>`;
            }

            // Next button
            paginationHtml += `
                <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                    <a class="page-link" href="#" onclick="changePage(${currentPage + 1})">بعدی</a>
                </li>
            `;

            pagination.innerHTML = paginationHtml;
        }

        function changePage(page) {
            if (page < 1 || page > totalPages || page === currentPage) return;
            
            currentPage = page;
            displayResults();
            updatePagination();
            
            // Scroll to top of table
            document.getElementById('resultsTable').scrollIntoView({ behavior: 'smooth' });
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('statusFilter').value = '';
            document.getElementById('typeFilter').value = '';
            filterResults();
        }

        function exportResults(format) {
            const params = new URLSearchParams({
                format: format,
                search: document.getElementById('searchInput').value,
                status: document.getElementById('statusFilter').value,
                type: document.getElementById('typeFilter').value
            });

            window.open(`/api/jobs/@Model.Id/export?${params.toString()}`, '_blank');
        }

        function hideLoading() {
            document.getElementById('loadingState').style.display = 'none';
        }

        function showError(message) {
            document.getElementById('loadingState').innerHTML = `
                <div class="text-center p-4">
                    <i class="bi bi-exclamation-triangle display-1 text-danger"></i>
                    <h5 class="mt-3 text-danger">خطا در بارگذاری</h5>
                    <p class="text-muted">${message}</p>
                    <button class="btn btn-outline-primary" onclick="location.reload()">تلاش مجدد</button>
                </div>
            `;
        }

        function formatDateTime(dateString) {
            const date = new Date(dateString);
            return date.toLocaleDateString('fa-IR') + ' ' + date.toLocaleTimeString('fa-IR');
        }

        function debounce(func, wait) {
            let timeout;
            return function executedFunction(...args) {
                const later = () => {
                    clearTimeout(timeout);
                    func(...args);
                };
                clearTimeout(timeout);
                timeout = setTimeout(later, wait);
            };
        }
    </script>
}
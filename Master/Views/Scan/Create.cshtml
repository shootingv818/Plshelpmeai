@model CreateScanJobRequest
@{
    ViewData["Title"] = "اسکن جدید";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-credit-card-2-front me-2"></i>
                    ایجاد اسکن جدید
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" id="scanForm">
                    <div class="row">
                        <!-- Card Information Section -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0">
                                        <i class="bi bi-credit-card me-2"></i>
                                        اطلاعات کارت
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label asp-for="CardNumber" class="form-label">
                                            <i class="bi bi-123 me-1"></i>
                                            شماره کارت *
                                        </label>
                                        <input asp-for="CardNumber" class="form-control" 
                                               placeholder="1234567812345678" 
                                               pattern="[0-9]{16}" 
                                               maxlength="19" 
                                               required>
                                        <span asp-validation-for="CardNumber" class="text-danger"></span>
                                        <small class="form-text text-muted">
                                            شماره کارت 16 رقمی (بدون فاصله)
                                        </small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">
                                            <i class="bi bi-shield-check me-1"></i>
                                            نوع اسکن
                                        </label>
                                        <div class="btn-group w-100" role="group">
                                            <input type="radio" class="btn-check" name="scanType" id="fullScan" value="full" checked>
                                            <label class="btn btn-outline-primary" for="fullScan">
                                                <i class="bi bi-search me-1"></i>
                                                کامل
                                            </label>
                                            
                                            <input type="radio" class="btn-check" name="scanType" id="expiryOnly" value="expiry">
                                            <label class="btn btn-outline-info" for="expiryOnly">
                                                <i class="bi bi-calendar me-1"></i>
                                                فقط انقضا
                                            </label>
                                            
                                            <input type="radio" class="btn-check" name="scanType" id="cvvOnly" value="cvv">
                                            <label class="btn btn-outline-warning" for="cvvOnly">
                                                <i class="bi bi-key me-1"></i>
                                                فقط CVV
                                            </label>
                                        </div>
                                        <small class="form-text text-muted">
                                            کامل: انقضا + CVV، فقط انقضا: تشخیص تاریخ انقضا، فقط CVV: اسکن رمز امنیتی
                                        </small>
                                    </div>

                                    <div class="mb-3" id="customRangeSection" style="display: none;">
                                        <label class="form-label">محدوده CVV سفارشی</label>
                                        <div class="row">
                                            <div class="col-6">
                                                <input type="number" class="form-control" id="cvvStart" 
                                                       placeholder="100" min="100" max="9999">
                                                <small class="text-muted">از</small>
                                            </div>
                                            <div class="col-6">
                                                <input type="number" class="form-control" id="cvvEnd" 
                                                       placeholder="9999" min="100" max="9999">
                                                <small class="text-muted">تا</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Phone Numbers Section -->
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header bg-success text-white">
                                    <h6 class="mb-0">
                                        <i class="bi bi-telephone me-2"></i>
                                        شماره تلفن‌های هدف
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="mb-3">
                                        <label class="form-label">شماره تلفن‌ها *</label>
                                        <textarea id="phoneNumbers" class="form-control" rows="6" 
                                                  placeholder="09123456789&#10;09987654321&#10;..." required></textarea>
                                        <small class="form-text text-muted">
                                            هر شماره را در یک خط جداگانه وارد کنید (حداکثر 10 شماره)
                                        </small>
                                    </div>

                                    <div class="mb-3">
                                        <button type="button" class="btn btn-outline-info btn-sm me-2" onclick="loadFromAccounts()">
                                            <i class="bi bi-person-badge me-1"></i>
                                            از اکانت‌ها
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="validatePhones()">
                                            <i class="bi bi-check-circle me-1"></i>
                                            بررسی
                                        </button>
                                    </div>

                                    <div id="phoneValidation" class="mb-3" style="display: none;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Advanced Settings -->
                    <div class="card mb-4">
                        <div class="card-header" data-bs-toggle="collapse" data-bs-target="#advancedSettings" style="cursor: pointer;">
                            <h6 class="mb-0">
                                <i class="bi bi-gear me-2"></i>
                                تنظیمات پیشرفته
                                <i class="bi bi-chevron-down float-end"></i>
                            </h6>
                        </div>
                        <div class="collapse" id="advancedSettings">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">اولویت</label>
                                            <select class="form-select" id="priority">
                                                <option value="normal" selected>معمولی</option>
                                                <option value="high">بالا</option>
                                                <option value="urgent">فوری</option>
                                            </select>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">تاخیر بین درخواست‌ها (ms)</label>
                                            <input type="number" class="form-control" id="requestDelay" 
                                                   value="1000" min="100" max="10000">
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <label class="form-label">تایم‌اوت (ثانیه)</label>
                                            <input type="number" class="form-control" id="timeout" 
                                                   value="30" min="10" max="300">
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="enableRetry" checked>
                                            <label class="form-check-label" for="enableRetry">
                                                تلاش مجدد در صورت خطا
                                            </label>
                                        </div>
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="notifyOnComplete" checked>
                                            <label class="form-check-label" for="notifyOnComplete">
                                                اطلاع‌رسانی پس از تکمیل
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Estimation Section -->
                    <div class="card mb-4">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0">
                                <i class="bi bi-clock me-2"></i>
                                برآورد زمان و منابع
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h4 class="text-primary mb-1" id="estimatedTasks">0</h4>
                                        <small class="text-muted">تسک</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h4 class="text-success mb-1" id="estimatedTime">0 دقیقه</h4>
                                        <small class="text-muted">زمان برآوردی</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h4 class="text-warning mb-1" id="estimatedCost">0</h4>
                                        <small class="text-muted">هزینه درخواست</small>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="text-center">
                                        <h4 class="text-info mb-1" id="availableWorkers">0</h4>
                                        <small class="text-muted">ورکر آماده</small>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mt-3">
                                <div class="progress">
                                    <div class="progress-bar" id="resourceBar" role="progressbar" style="width: 0%"></div>
                                </div>
                                <small class="text-muted" id="resourceText">منابع در دسترس</small>
                            </div>
                        </div>
                    </div>

                    <!-- Hidden input for phone numbers -->
                    <input type="hidden" id="phoneNumbersHidden" name="PhoneNumbers">

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("Index")" class="btn btn-secondary">
                            <i class="bi bi-arrow-right me-1"></i>
                            بازگشت
                        </a>
                        
                        <div>
                            <button type="button" class="btn btn-outline-info me-2" onclick="previewScan()">
                                <i class="bi bi-eye me-1"></i>
                                پیش‌نمایش
                            </button>
                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                <i class="bi bi-play me-1"></i>
                                شروع اسکن
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Preview Modal -->
<div class="modal fade" id="previewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">پیش‌نمایش اسکن</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="previewContent">
                <!-- Preview content will be loaded here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
                <button type="button" class="btn btn-primary" onclick="submitFromPreview()">
                    <i class="bi bi-play me-1"></i>
                    تأیید و شروع
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Phone Selection Modal -->
<div class="modal fade" id="phoneSelectionModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">انتخاب شماره تلفن از اکانت‌ها</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" class="form-control" id="accountSearch" placeholder="جستجو در اکانت‌ها...">
                </div>
                <div id="accountsList" class="list-group" style="max-height: 300px; overflow-y: auto;">
                    <!-- Accounts will be loaded here -->
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-primary" onclick="addSelectedPhones()">
                    <i class="bi bi-plus me-1"></i>
                    افزودن انتخاب شده‌ها
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedPhones = new Set();
        
        // Card number formatting
        document.querySelector('input[name="CardNumber"]').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 16) {
                value = value.substring(0, 16);
            }
            
            // Add spaces for readability
            const formatted = value.replace(/(.{4})/g, '$1 ').trim();
            e.target.value = formatted;
            
            // Visual validation
            const isValid = value.length === 16;
            e.target.classList.toggle('is-valid', isValid);
            e.target.classList.toggle('is-invalid', value.length > 0 && !isValid);
            
            updateEstimation();
        });

        // Phone number validation
        function validatePhones() {
            const phoneText = document.getElementById('phoneNumbers').value;
            const phones = phoneText.split('\n').map(p => p.trim()).filter(p => p.length > 0);
            
            if (phones.length === 0) {
                showValidationResult('لطفاً حداقل یک شماره تلفن وارد کنید', 'warning');
                return;
            }
            
            if (phones.length > 10) {
                showValidationResult('حداکثر 10 شماره تلفن مجاز است', 'warning');
                return;
            }
            
            const validPhones = [];
            const invalidPhones = [];
            
            phones.forEach(phone => {
                if (/^09[0-9]{9}$/.test(phone)) {
                    validPhones.push(phone);
                } else {
                    invalidPhones.push(phone);
                }
            });
            
            let resultHtml = '';
            if (validPhones.length > 0) {
                resultHtml += `<div class="alert alert-success">
                    <strong>شماره‌های معتبر (${validPhones.length}):</strong><br>
                    ${validPhones.join('<br>')}
                </div>`;
            }
            
            if (invalidPhones.length > 0) {
                resultHtml += `<div class="alert alert-danger">
                    <strong>شماره‌های نامعتبر (${invalidPhones.length}):</strong><br>
                    ${invalidPhones.join('<br>')}
                </div>`;
            }
            
            showValidationResult(resultHtml);
            updateEstimation();
        }

        function showValidationResult(content, type = '') {
            const validationDiv = document.getElementById('phoneValidation');
            if (type) {
                validationDiv.innerHTML = `<div class="alert alert-${type}">${content}</div>`;
            } else {
                validationDiv.innerHTML = content;
            }
            validationDiv.style.display = 'block';
        }

        // Load phones from accounts
        function loadFromAccounts() {
            fetch('/Accounts/GetAccountsJson')
                .then(response => response.json())
                .then(accounts => {
                    displayAccountsModal(accounts);
                })
                .catch(error => {
                    console.error('Error loading accounts:', error);
                    IvaScanner.showNotification('خطا در بارگذاری اکانت‌ها', 'error');
                });
        }

        function displayAccountsModal(accounts) {
            const accountsList = document.getElementById('accountsList');
            accountsList.innerHTML = '';
            
            accounts.forEach(account => {
                if (account.isActive && account.status === 'Active') {
                    const item = document.createElement('div');
                    item.className = 'list-group-item';
                    item.innerHTML = `
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="${account.phoneNumber}" id="account-${account.id}">
                            <label class="form-check-label" for="account-${account.id}">
                                <strong>${account.phoneNumber}</strong>
                                ${account.assignedWorker ? 
                                    `<span class="badge bg-info ms-2">${account.assignedWorker.name}</span>` : 
                                    '<span class="badge bg-success ms-2">آزاد</span>'
                                }
                            </label>
                        </div>
                    `;
                    accountsList.appendChild(item);
                }
            });
            
            new bootstrap.Modal(document.getElementById('phoneSelectionModal')).show();
        }

        function addSelectedPhones() {
            const checkboxes = document.querySelectorAll('#accountsList input[type="checkbox"]:checked');
            const selectedNumbers = Array.from(checkboxes).map(cb => cb.value);
            
            if (selectedNumbers.length === 0) {
                IvaScanner.showNotification('لطفاً حداقل یک شماره انتخاب کنید', 'warning');
                return;
            }
            
            const currentPhones = document.getElementById('phoneNumbers').value;
            const newPhones = currentPhones ? currentPhones + '\n' + selectedNumbers.join('\n') : selectedNumbers.join('\n');
            
            document.getElementById('phoneNumbers').value = newPhones;
            bootstrap.Modal.getInstance(document.getElementById('phoneSelectionModal')).hide();
            
            IvaScanner.showNotification(`${selectedNumbers.length} شماره اضافه شد`, 'success');
            validatePhones();
        }

        // Update estimation
        function updateEstimation() {
            const cardNumber = document.querySelector('input[name="CardNumber"]').value.replace(/\s/g, '');
            const phoneText = document.getElementById('phoneNumbers').value;
            const phones = phoneText.split('\n').map(p => p.trim()).filter(p => p.length > 0);
            const scanType = document.querySelector('input[name="scanType"]:checked').value;
            
            if (cardNumber.length !== 16 || phones.length === 0) {
                resetEstimation();
                return;
            }
            
            let tasks = 0;
            let estimatedMinutes = 0;
            
            switch (scanType) {
                case 'full':
                    tasks = 1 + 99; // 1 expiry task + 99 CVV tasks
                    estimatedMinutes = Math.ceil(tasks * 2 / Math.max(1, phones.length));
                    break;
                case 'expiry':
                    tasks = 1;
                    estimatedMinutes = 2;
                    break;
                case 'cvv':
                    tasks = 99;
                    estimatedMinutes = Math.ceil(tasks * 2 / Math.max(1, phones.length));
                    break;
            }
            
            const cost = tasks * phones.length * 0.1; // Example cost calculation
            
            document.getElementById('estimatedTasks').textContent = tasks;
            document.getElementById('estimatedTime').textContent = `${estimatedMinutes} دقیقه`;
            document.getElementById('estimatedCost').textContent = Math.round(cost);
            
            // Load available workers
            fetch('/Workers/GetWorkerStats')
                .then(response => response.json())
                .then(stats => {
                    const availableWorkers = stats.online || 0;
                    document.getElementById('availableWorkers').textContent = availableWorkers;
                    
                    // Update resource bar
                    const resourcePercentage = Math.min(100, (availableWorkers / Math.max(1, tasks)) * 100);
                    document.getElementById('resourceBar').style.width = `${resourcePercentage}%`;
                    
                    if (resourcePercentage >= 80) {
                        document.getElementById('resourceBar').className = 'progress-bar bg-success';
                        document.getElementById('resourceText').textContent = 'منابع کافی در دسترس';
                    } else if (resourcePercentage >= 50) {
                        document.getElementById('resourceBar').className = 'progress-bar bg-warning';
                        document.getElementById('resourceText').textContent = 'منابع متوسط';
                    } else {
                        document.getElementById('resourceBar').className = 'progress-bar bg-danger';
                        document.getElementById('resourceText').textContent = 'منابع محدود - اسکن ممکن است کند باشد';
                    }
                })
                .catch(error => console.error('Error loading worker stats:', error));
        }

        function resetEstimation() {
            document.getElementById('estimatedTasks').textContent = '0';
            document.getElementById('estimatedTime').textContent = '0 دقیقه';
            document.getElementById('estimatedCost').textContent = '0';
            document.getElementById('availableWorkers').textContent = '0';
            document.getElementById('resourceBar').style.width = '0%';
        }

        // Preview scan
        function previewScan() {
            const cardNumber = document.querySelector('input[name="CardNumber"]').value.replace(/\s/g, '');
            const phoneText = document.getElementById('phoneNumbers').value;
            const phones = phoneText.split('\n').map(p => p.trim()).filter(p => p.length > 0);
            const scanType = document.querySelector('input[name="scanType"]:checked').value;
            
            if (!validateScanData(cardNumber, phones)) {
                return;
            }
            
            const previewContent = generatePreviewContent(cardNumber, phones, scanType);
            document.getElementById('previewContent').innerHTML = previewContent;
            
            new bootstrap.Modal(document.getElementById('previewModal')).show();
        }

        function validateScanData(cardNumber, phones) {
            if (cardNumber.length !== 16) {
                IvaScanner.showNotification('شماره کارت معتبر نیست', 'error');
                return false;
            }
            
            if (phones.length === 0) {
                IvaScanner.showNotification('لطفاً حداقل یک شماره تلفن وارد کنید', 'error');
                return false;
            }
            
            const invalidPhones = phones.filter(phone => !/^09[0-9]{9}$/.test(phone));
            if (invalidPhones.length > 0) {
                IvaScanner.showNotification('برخی شماره تلفن‌ها نامعتبر هستند', 'error');
                return false;
            }
            
            return true;
        }

        function generatePreviewContent(cardNumber, phones, scanType) {
            const scanTypeNames = {
                'full': 'اسکن کامل (انقضا + CVV)',
                'expiry': 'فقط تشخیص انقضا',
                'cvv': 'فقط اسکن CVV'
            };
            
            return `
                <div class="row">
                    <div class="col-md-6">
                        <h6>اطلاعات کارت:</h6>
                        <p><strong>شماره کارت:</strong> ${cardNumber.replace(/(.{4})/g, '$1 ').trim()}</p>
                        <p><strong>نوع اسکن:</strong> ${scanTypeNames[scanType]}</p>
                    </div>
                    <div class="col-md-6">
                        <h6>شماره تلفن‌ها (${phones.length}):</h6>
                        <ul class="list-unstyled">
                            ${phones.map(phone => `<li><code>${phone}</code></li>`).join('')}
                        </ul>
                    </div>
                </div>
                
                <div class="alert alert-info">
                    <h6><i class="bi bi-info-circle me-2"></i>خلاصه اسکن:</h6>
                    <ul class="mb-0">
                        <li>تعداد تسک‌ها: ${document.getElementById('estimatedTasks').textContent}</li>
                        <li>زمان برآوردی: ${document.getElementById('estimatedTime').textContent}</li>
                        <li>ورکرهای آماده: ${document.getElementById('availableWorkers').textContent}</li>
                    </ul>
                </div>
                
                <div class="alert alert-warning">
                    <strong>توجه:</strong> پس از شروع اسکن، امکان تغییر اطلاعات کارت وجود ندارد. 
                    فقط می‌توانید اسکن را متوقف، ادامه دهید یا لغو کنید.
                </div>
            `;
        }

        // Form submission
        document.getElementById('scanForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const cardNumber = document.querySelector('input[name="CardNumber"]').value.replace(/\s/g, '');
            const phoneText = document.getElementById('phoneNumbers').value;
            const phones = phoneText.split('\n').map(p => p.trim()).filter(p => p.length > 0);
            
            if (!validateScanData(cardNumber, phones)) {
                return;
            }
            
            // Set hidden input
            document.getElementById('phoneNumbersHidden').value = JSON.stringify(phones);
            
            // Update form data
            document.querySelector('input[name="CardNumber"]').value = cardNumber;
            
            // Add loading state
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>در حال ایجاد...';
            submitBtn.disabled = true;
            
            // Submit form
            this.submit();
        });

        function submitFromPreview() {
            bootstrap.Modal.getInstance(document.getElementById('previewModal')).hide();
            document.getElementById('scanForm').dispatchEvent(new Event('submit'));
        }

        // Event listeners
        document.querySelectorAll('input[name="scanType"]').forEach(radio => {
            radio.addEventListener('change', updateEstimation);
        });

        document.getElementById('phoneNumbers').addEventListener('input', updateEstimation);

        // Initial estimation
        updateEstimation();
    </script>
}
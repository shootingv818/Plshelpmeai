<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه اسکنر ایوا</title>

    <!-- Persian font (Vazirmatn) -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet" type="text/css" />

    <!-- Bootstrap 5 + Bootstrap Icons (single icon set used across the whole app) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <link href="~/css/site.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-brand">
                <span class="sidebar-brand-icon"><i class="bi bi-shield-check"></i></span>
                <span class="sidebar-brand-text">اسکنر ایوا</span>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")"
                   href="@Url.Action("Index", "Home")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>داشبورد</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Scan" ? "active" : "")"
                   href="@Url.Action("Index", "Scan")">
                    <i class="bi bi-search"></i>
                    <span>اسکن کارت‌ها</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Workers" ? "active" : "")"
                   href="@Url.Action("Index", "Workers")">
                    <i class="bi bi-people"></i>
                    <span>مدیریت ورکرها</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "RemoteServer" ? "active" : "")"
                   href="@Url.Action("Index", "RemoteServer")">
                    <i class="bi bi-hdd-network"></i>
                    <span>سرورهای Remote</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Accounts" ? "active" : "")"
                   href="@Url.Action("Index", "Accounts")">
                    <i class="bi bi-person-badge"></i>
                    <span>اکانت‌های ایوا</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Proxy" ? "active" : "")"
                   href="@Url.Action("Index", "Proxy")">
                    <i class="bi bi-globe2"></i>
                    <span>پروکسی‌ها</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Logs" ? "active" : "")"
                   href="@Url.Action("Index", "Logs")">
                    <i class="bi bi-journal-text"></i>
                    <span>لاگ‌های سیستم</span>
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "active" : "")"
                   href="@Url.Action("Index", "Settings")">
                    <i class="bi bi-gear"></i>
                    <span>تنظیمات</span>
                </a>
            </nav>
        </aside>

        <!-- Main -->
        <div class="app-main">
            <header class="app-topbar">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="منو">
                    <i class="bi bi-list"></i>
                </button>

                <h1 class="app-title">@ViewData["Title"]</h1>

                <div class="topbar-actions">
                    <span class="conn-badge conn-online" id="real-time-stats">
                        <i class="bi bi-broadcast"></i>
                        <span>آنلاین</span>
                    </span>
                    <span class="topbar-clock" id="current-time"></span>
                </div>
            </header>

            <main class="app-content">
                <!-- Alerts -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="bi bi-check-circle me-2"></i>
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        @ViewBag.ErrorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/signalr-dashboard.js"></script>

    <script>
        // Sidebar toggle (mobile)
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('open');
        });

        // Live clock
        function updateTime() {
            const now = new Date();
            const el = document.getElementById('current-time');
            if (el) {
                el.textContent = now.toLocaleString('fa-IR', {
                    hour: '2-digit', minute: '2-digit', second: '2-digit'
                });
            }
        }
        setInterval(updateTime, 1000);
        updateTime();

        // Auto-dismiss alerts
        setTimeout(function () {
            document.querySelectorAll('.alert').forEach(alert => {
                if (alert.querySelector('.btn-close')) {
                    bootstrap.Alert.getOrCreateInstance(alert).close();
                }
            });
        }, 5000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
[Unit]
Description=IVA Scanner Worker Service
Documentation=https://github.com/shootingv818/Plshelpmeai
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
# Replace with actual paths
WorkingDirectory=/opt/iva-scanner/worker
ExecStart=/usr/bin/dotnet /opt/iva-scanner/worker/IvaScanner.Worker.dll
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

# User and group (create dedicated user for security)
User=iva-worker
Group=iva-worker

# Security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/iva-scanner/worker/logs
ReadWritePaths=/opt/iva-scanner/worker/temp
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true

# Resource limits
LimitNOFILE=8192
MemoryMax=1G
CPUQuota=80%

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iva-worker

[Install]
WantedBy=multi-user.target
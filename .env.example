# ===== تنظیمات ربات تلگرام =====
# آیدی API تلگرام (از my.telegram.org)
API_ID=12345678
# هش API تلگرام
API_HASH=your_api_hash_here
# توکن ربات (از @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
# آیدی عددی مالک ربات
OWNER_ID=123456789
# آیدی گروه لاگ (اختیاری)
LOG_GROUP_ID=-1001234567890

# ===== حالت اجرا =====
# master = ربات تلگرام (هماهنگ‌کننده)
# worker = سرور API (فقط اجرای دستورات)
MODE=master

# ===== تنظیمات ورکر =====
# کلید Fernet برای رمزنگاری اطلاعات حساس
# تولید: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
WORKER_SECRET=
# پورت API ورکر (فقط loopback)
WORKER_API_PORT=8765
# توکن API ورکر (فقط برای MODE=worker)
WORKER_API_TOKEN=
# آدرس bind سرور ورکر
WORKER_BIND_HOST=127.0.0.1

# ===== گیت (برای استقرار ورکر) =====
GIT_REPO_URL=https://github.com/your/repo.git
GIT_BRANCH=main

# ===== اسکنر =====
# تاخیر بین هر تست (ثانیه)
SCAN_DELAY=0.15
# مبلغ شارژ تست (ریال)
SCAN_CHARGE_AMOUNT=10000
# شماره هدف برای خرید شارژ
SCAN_TARGET_MOBILE=09121234567
# آیدی اپراتور
SCAN_PROVIDER_ID=10

# ===== عمومی =====
TIMEZONE=Asia/Tehran
